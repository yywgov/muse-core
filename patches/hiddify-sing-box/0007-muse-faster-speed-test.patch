index 00000000..3f51e8c7
--- /dev/null
+++ b/common/monitoring/muse_parallel.go
@@ -0,0 +1,87 @@
+package monitoring
+
+// muse (穿云 1.4.0): faster 测速 over dozens of nodes (Cloudflare 优选 lists of 50+ entries kept
+// many rows at 「测速中」 for a minute):
+//   - 16 test workers instead of 10 (the app can set 4–64);
+//   - a 测速 the user asked for is queued with priority, ahead of the periodic cycle;
+//   - after a lost warm-up probe the samples get a short timeout, so a dead node holds a worker
+//     about timeout + 3 s instead of twice the timeout;
+//   - the exit-IP lookup of a node runs after its delay was reported, off the test workers, at
+//     most museIpInfoParallel at a time.
+
+import (
+	"context"
+	"sync"
+	"time"
+
+	"github.com/sagernet/sing-box/hiddify/ipinfo"
+)
+
+const (
+	museIpInfoParallel     = 4
+	museLostWarmupMaxProbe = 3 * time.Second
+	museMinWorkers         = 4
+	museMaxWorkers         = 64
+)
+
+var (
+	museIpInfoSlots    = make(chan struct{}, museIpInfoParallel)
+	museIpInfoInFlight sync.Map // tag -> struct{}
+)
+
+// museLostWarmupTimeout is the sample timeout after the warm-up probe got no answer.
+func museLostWarmupTimeout(full time.Duration) time.Duration {
+	if full < museLostWarmupMaxProbe {
+		return full
+	}
+	return museLostWarmupMaxProbe
+}
+
+// MuseClampWorkers keeps a worker count the app sent within 4–64 (0 = default).
+func MuseClampWorkers(n int) int {
+	if n <= 0 {
+		return defaultWorkerCount
+	}
+	if n < museMinWorkers {
+		return museMinWorkers
+	}
+	if n > museMaxWorkers {
+		return museMaxWorkers
+	}
+	return n
+}
+
+// lookupIpInfoLater looks up the exit IP of [tag] in the background (once at a time per node).
+func (m *OutboundMonitoring) lookupIpInfoLater(tag string) {
+	if _, busy := museIpInfoInFlight.LoadOrStore(tag, struct{}{}); busy {
+		return
+	}
+	go func() {
+		defer museIpInfoInFlight.Delete(tag)
+		select {
+		case museIpInfoSlots <- struct{}{}:
+		case <-m.ctx.Done():
+			return
+		}
+		defer func() { <-museIpInfoSlots }()
+		state := m.getState(tag)
+		if state == nil {
+			return
+		}
+		ctx, cancel := context.WithTimeout(m.ctx, m.urlTestTimeout)
+		defer cancel()
+		newip, _, err := ipinfo.GetIpInfo(m.logger, ctx, state.outbound)
+		if err != nil || newip == nil {
+			return
+		}
+		state.mu.Lock()
+		state.history.IpInfo = mergeIpInfo(state.history.IpInfo, newip)
+		history := state.history
+		groups := state.groupTags
+		state.mu.Unlock()
+		m.history.StoreURLTestHistory(tag, &history)
+		m.cacheDirty.Store(true)
+		m.emitGroupEvent(groups)
+		m.logger.Info("outbound ", tag, " IP ", newip.IP)
+	}()
+}
diff --git a/common/monitoring/muse_parallel_test.go b/common/monitoring/muse_parallel_test.go
new file mode 100644
index 00000000..091da1d5
--- /dev/null
+++ b/common/monitoring/muse_parallel_test.go
@@ -0,0 +1,24 @@
+package monitoring
+
+import (
+	"testing"
+	"time"
+)
+
+func TestMuseClampWorkers(t *testing.T) {
+	cases := map[int]int{0: 16, -1: 16, 1: 4, 16: 16, 32: 32, 500: 64}
+	for in, want := range cases {
+		if got := MuseClampWorkers(in); got != want {
+			t.Fatalf("MuseClampWorkers(%d) = %d, want %d", in, got, want)
+		}
+	}
+}
+
+func TestMuseLostWarmupTimeout(t *testing.T) {
+	if got := museLostWarmupTimeout(5 * time.Second); got != 3*time.Second {
+		t.Fatalf("got %v", got)
+	}
+	if got := museLostWarmupTimeout(2 * time.Second); got != 2*time.Second {
+		t.Fatalf("got %v", got)
+	}
+}
