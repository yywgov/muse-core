--- /dev/null
+++ b/common/tls/muse_reality_version.go
@@ -0,0 +1,23 @@
+//go:build with_utls
+
+package tls
+
+// realityClientVersion is the client version a REALITY ClientHello carries in
+// the first three bytes of its session ID (major, minor, patch). Servers can
+// refuse versions outside their configured minimum/maximum, and some releases
+// default the minimum to 26.3.27, so keep this at or above current servers.
+// Bump it here only.
+var realityClientVersion = [3]byte{26, 10, 21}
+
+// realityWriteSessionHeader fills the plaintext REALITY session ID header:
+// version (3 bytes), a reserved zero byte, the Unix time (4 bytes, big
+// endian) and the short ID (8 bytes).
+func realityWriteSessionHeader(sessionID []byte, unix uint32, shortID [8]byte) {
+	copy(sessionID[:3], realityClientVersion[:])
+	sessionID[3] = 0
+	sessionID[4] = byte(unix >> 24)
+	sessionID[5] = byte(unix >> 16)
+	sessionID[6] = byte(unix >> 8)
+	sessionID[7] = byte(unix)
+	copy(sessionID[8:16], shortID[:])
+}
