+//go:build with_utls
+
+package tls
+
+import (
+	"strings"
+
+	utls "github.com/metacubex/utls"
+)
+
+func realityModeKey(serverAddress string, uClient *UTLSClientConfig, publicKey, shortID string) string {
+	return strings.Join([]string{serverAddress, uClient.ServerName(), publicKey, shortID, uClient.id.Str()}, "|")
+}
+
+func realityRandomizedSpec(id utls.ClientHelloID) bool {
+	return strings.HasPrefix(id.Client, "Randomized")
+}
+
+func realityHelloGroups(uConn *utls.UConn) (curves *utls.SupportedCurvesExtension, keyShares *utls.KeyShareExtension) {
+	for _, extension := range uConn.Extensions {
+		switch ext := extension.(type) {
+		case *utls.SupportedCurvesExtension:
+			curves = ext
+		case *utls.KeyShareExtension:
+			keyShares = ext
+		}
+	}
+	return
+}
+
+func realityHasCurve(curves *utls.SupportedCurvesExtension, id utls.CurveID) bool {
+	if curves == nil {
+		return false
+	}
+	for _, c := range curves.Curves {
+		if c == id {
+			return true
+		}
+	}
+	return false
+}
+
+func realityHasKeyShare(keyShares *utls.KeyShareExtension, id utls.CurveID) bool {
+	if keyShares == nil {
+		return false
+	}
+	for _, s := range keyShares.KeyShares {
+		if s.Group == id {
+			return true
+		}
+	}
+	return false
+}
+
+// realityNativePostQuantum: the fingerprint is a fixed modern spec (not a
+// randomized one) whose own hello pairs X25519MLKEM768 in supported groups
+// and key shares.
+func realityNativePostQuantum(uConn *utls.UConn, id utls.ClientHelloID) bool {
+	if realityRandomizedSpec(id) {
+		return false
+	}
+	curves, keyShares := realityHelloGroups(uConn)
+	return realityHasCurve(curves, utls.X25519MLKEM768) && realityHasKeyShare(keyShares, utls.X25519MLKEM768)
+}
+
+// prepareRealityKeyShares shapes a built hello for the key share mode and
+// returns the mode actually used plus the other mode this fingerprint can
+// produce (realityModeAuto when there is none).
+//
+//   - post-quantum: the spec's own X25519MLKEM768 share is kept, with the
+//     group listed in supported groups so the pair matches.
+//   - X25519: X25519MLKEM768 is removed from supported groups and key shares.
+//
+// Either way the REALITY auth key comes from the X25519 share.
+func prepareRealityKeyShares(uConn *utls.UConn, id utls.ClientHelloID, mode realityKeyShareMode) (realityKeyShareMode, realityKeyShareMode, error) {
+	curves, keyShares := realityHelloGroups(uConn)
+	hasPQShare := realityHasKeyShare(keyShares, utls.X25519MLKEM768)
+	if mode == realityModeAuto {
+		if realityNativePostQuantum(uConn, id) {
+			mode = realityModePostQuantum
+		} else {
+			mode = realityModeX25519
+		}
+	}
+	if mode == realityModePostQuantum && !hasPQShare {
+		// This spec has no post-quantum share to send.
+		mode = realityModeX25519
+	}
+	if mode == realityModePostQuantum {
+		if curves != nil && !realityHasCurve(curves, utls.X25519MLKEM768) {
+			curves.Curves = append([]utls.CurveID{utls.X25519MLKEM768}, curves.Curves...)
+			if err := uConn.BuildHandshakeState(); err != nil {
+				return mode, realityModeAuto, err
+			}
+		}
+		return mode, realityModeX25519, nil
+	}
+	changed := false
+	if curves != nil && realityHasCurve(curves, utls.X25519MLKEM768) {
+		filtered := make([]utls.CurveID, 0, len(curves.Curves))
+		for _, c := range curves.Curves {
+			if c != utls.X25519MLKEM768 {
+				filtered = append(filtered, c)
+			}
+		}
+		curves.Curves = filtered
+		changed = true
+	}
+	if hasPQShare {
+		filtered := make([]utls.KeyShare, 0, len(keyShares.KeyShares))
+		for _, s := range keyShares.KeyShares {
+			if s.Group != utls.X25519MLKEM768 {
+				filtered = append(filtered, s)
+			}
+		}
+		keyShares.KeyShares = filtered
+		changed = true
+	}
+	if changed {
+		if err := uConn.BuildHandshakeState(); err != nil {
+			return mode, realityModeAuto, err
+		}
+	}
+	alternate := realityModeAuto
+	if hasPQShare {
+		alternate = realityModePostQuantum
+	}
+	return mode, alternate, nil
+}
