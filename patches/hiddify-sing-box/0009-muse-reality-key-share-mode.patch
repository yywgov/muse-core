@@ -0,0 +1,130 @@
+package tls
+
+import (
+	"context"
+	"errors"
+	"net"
+	"sync"
+
+	E "github.com/sagernet/sing/common/exceptions"
+)
+
+// realityKeyShareMode is which key share a REALITY hello carries.
+type realityKeyShareMode uint8
+
+const (
+	// realityModeAuto: post-quantum when the fingerprint carries it natively, X25519 otherwise.
+	realityModeAuto realityKeyShareMode = iota
+	// realityModePostQuantum: X25519MLKEM768 next to the plain X25519 share.
+	realityModePostQuantum
+	// realityModeX25519: plain X25519 only.
+	realityModeX25519
+)
+
+func (m realityKeyShareMode) String() string {
+	switch m {
+	case realityModePostQuantum:
+		return "X25519MLKEM768"
+	case realityModeX25519:
+		return "X25519"
+	default:
+		return "auto"
+	}
+}
+
+// realityHandshakeError is a REALITY handshake that reached the server and
+// failed. alternate is the other key share mode worth one retry
+// (realityModeAuto when the fingerprint cannot produce another mode).
+type realityHandshakeError struct {
+	alternate realityKeyShareMode
+	err       error
+}
+
+func (e *realityHandshakeError) Error() string { return e.err.Error() }
+func (e *realityHandshakeError) Unwrap() error { return e.err }
+
+// realityModeCache remembers, in memory, the key share mode that last worked
+// for each REALITY server.
+type realityModeCache struct {
+	access sync.Mutex
+	modes  map[string]realityKeyShareMode
+}
+
+var realityModes = &realityModeCache{}
+
+func (c *realityModeCache) preferred(key string) realityKeyShareMode {
+	c.access.Lock()
+	defer c.access.Unlock()
+	return c.modes[key]
+}
+
+func (c *realityModeCache) succeeded(key string, mode realityKeyShareMode) {
+	if mode == realityModeAuto {
+		return
+	}
+	c.access.Lock()
+	defer c.access.Unlock()
+	if c.modes == nil {
+		c.modes = make(map[string]realityKeyShareMode)
+	}
+	c.modes[key] = mode
+}
+
+// failed is called after a failed handshake. Without a retry on a fresh
+// connection following, the next connection starts with the other mode.
+func (c *realityModeCache) failed(key string, used, alternate realityKeyShareMode, retryPending bool) {
+	if retryPending || alternate == realityModeAuto || alternate == used {
+		return
+	}
+	c.succeeded(key, alternate)
+}
+
+type (
+	realityModeContextKey  struct{}
+	realityRetryContextKey struct{}
+)
+
+func realityModeFromContext(ctx context.Context) (realityKeyShareMode, bool) {
+	mode, ok := ctx.Value(realityModeContextKey{}).(realityKeyShareMode)
+	return mode, ok
+}
+
+func realityRetryPending(ctx context.Context) bool {
+	pending, _ := ctx.Value(realityRetryContextKey{}).(bool)
+	return pending
+}
+
+// ClientHandshakeRedial is ClientHandshake, plus: when a REALITY handshake
+// fails, it dials once more and retries with the other key share mode
+// (post-quantum ⇄ X25519). The mode that works is remembered per server.
+func ClientHandshakeRedial(ctx context.Context, conn net.Conn, config Config, redial func(ctx context.Context) (net.Conn, error)) (Conn, error) {
+	return realityHandshakeWithRetry(ctx, conn, config, redial, ClientHandshake)
+}
+
+type realityHandshakeFunc func(ctx context.Context, conn net.Conn, config Config) (Conn, error)
+
+func realityHandshakeWithRetry(ctx context.Context, conn net.Conn, config Config, redial func(ctx context.Context) (net.Conn, error), handshake realityHandshakeFunc) (Conn, error) {
+	if redial == nil {
+		return handshake(ctx, conn, config)
+	}
+	retryCtx := context.WithValue(ctx, realityRetryContextKey{}, true)
+	tlsConn, err := handshake(retryCtx, conn, config)
+	if err == nil {
+		return tlsConn, nil
+	}
+	var hsErr *realityHandshakeError
+	if !errors.As(err, &hsErr) || hsErr.alternate == realityModeAuto || ctx.Err() != nil {
+		return nil, err
+	}
+	conn.Close()
+	retryConn, dialErr := redial(ctx)
+	if dialErr != nil {
+		return nil, err
+	}
+	tlsConn, retryErr := handshake(context.WithValue(retryCtx, realityModeContextKey{}, hsErr.alternate), retryConn, config)
+	if retryErr != nil {
+		retryConn.Close()
+		return nil, E.Cause(retryErr, "reality retry with ", hsErr.alternate.String(), " key share (first attempt: ", err.Error(), ")")
+	}
+	return tlsConn, nil
+}
