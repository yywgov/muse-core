+//go:build with_utls
+
+package tls
+
+import (
+	"bytes"
+	"context"
+	"crypto/ecdh"
+	"encoding/base64"
+	"encoding/binary"
+	"errors"
+	"io"
+	"net"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common/logger"
+
+	utls "github.com/metacubex/utls"
+)
+
+const museGroupPQ = uint16(utls.X25519MLKEM768)
+
+// museHelloGroups reads supported groups and key share groups from a
+// serialized ClientHello handshake message.
+func museHelloGroups(t *testing.T, raw []byte) (groups, shares []uint16) {
+	t.Helper()
+	if len(raw) < 4 || raw[0] != 1 {
+		t.Fatalf("not a ClientHello: % x", raw[:min(len(raw), 8)])
+	}
+	b := raw[4:]
+	b = b[2+32:]
+	b = b[1+int(b[0]):]
+	b = b[2+int(binary.BigEndian.Uint16(b)):]
+	b = b[1+int(b[0]):]
+	b = b[2:]
+	for len(b) >= 4 {
+		typ, l := binary.BigEndian.Uint16(b), int(binary.BigEndian.Uint16(b[2:]))
+		data := b[4 : 4+l]
+		b = b[4+l:]
+		switch typ {
+		case 10:
+			list := data[2:]
+			for i := 0; i+1 < len(list); i += 2 {
+				groups = append(groups, binary.BigEndian.Uint16(list[i:]))
+			}
+		case 51:
+			list := data[2:]
+			for len(list) >= 4 {
+				g, kl := binary.BigEndian.Uint16(list), int(binary.BigEndian.Uint16(list[2:]))
+				shares = append(shares, g)
+				list = list[4+kl:]
+			}
+		}
+	}
+	return
+}
+
+func museHas(list []uint16, v uint16) bool {
+	for _, x := range list {
+		if x == v {
+			return true
+		}
+	}
+	return false
+}
+
+func musePrepared(t *testing.T, id utls.ClientHelloID, mode realityKeyShareMode) (*utls.UConn, realityKeyShareMode, realityKeyShareMode) {
+	t.Helper()
+	client, server := net.Pipe()
+	t.Cleanup(func() {
+		client.Close()
+		server.Close()
+	})
+	uConn := utls.UClient(client, &utls.Config{ServerName: "example.com", InsecureSkipVerify: true}, id)
+	if err := uConn.BuildHandshakeState(); err != nil {
+		t.Fatal(err)
+	}
+	used, alternate, err := prepareRealityKeyShares(uConn, id, mode)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return uConn, used, alternate
+}
+
+// museCheckAuthKey: the auth key is the private key of the X25519 share in the hello.
+func museCheckAuthKey(t *testing.T, uConn *utls.UConn) {
+	t.Helper()
+	key, err := realityAuthECDHEKey(uConn.HandshakeState.State13.KeyShareKeys)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if key.Curve() != ecdh.X25519() {
+		t.Fatal("auth key is not X25519")
+	}
+	pub := key.PublicKey().Bytes()
+	for _, extension := range uConn.Extensions {
+		if ks, ok := extension.(*utls.KeyShareExtension); ok {
+			for _, s := range ks.KeyShares {
+				if s.Group == utls.X25519 && bytes.Equal(s.Data, pub) {
+					if !bytes.Contains(uConn.HandshakeState.Hello.Raw, pub) {
+						t.Fatal("X25519 share not in the serialized hello")
+					}
+					return
+				}
+				if s.Group == utls.X25519MLKEM768 && len(s.Data) == 1184+32 && bytes.Equal(s.Data[1184:], pub) {
+					return
+				}
+			}
+		}
+	}
+	t.Fatal("auth key does not match an X25519 key share in the hello")
+}
+
+func museCheckX25519Only(t *testing.T, uConn *utls.UConn) {
+	t.Helper()
+	groups, shares := museHelloGroups(t, uConn.HandshakeState.Hello.Raw)
+	if museHas(groups, museGroupPQ) || museHas(shares, museGroupPQ) {
+		t.Fatalf("X25519 mode hello still carries X25519MLKEM768: groups %x shares %x", groups, shares)
+	}
+	if !museHas(shares, uint16(utls.X25519)) {
+		t.Fatalf("X25519 mode hello lacks an X25519 share: %x", shares)
+	}
+	museCheckAuthKey(t, uConn)
+}
+
+func museCheckPaired(t *testing.T, uConn *utls.UConn) {
+	t.Helper()
+	groups, shares := museHelloGroups(t, uConn.HandshakeState.Hello.Raw)
+	if !museHas(groups, museGroupPQ) || !museHas(shares, museGroupPQ) {
+		t.Fatalf("post-quantum hello must list X25519MLKEM768 in groups and shares: groups %x shares %x", groups, shares)
+	}
+	for _, s := range shares {
+		if !museHas(groups, s) {
+			t.Fatalf("key share %x not in supported groups %x", s, groups)
+		}
+	}
+	museCheckAuthKey(t, uConn)
+}
+
+func TestMuseRealityModeChrome(t *testing.T) {
+	for _, name := range []string{"chrome", "edge", "random"} {
+		id, err := uTLSClientHelloID(name)
+		if err != nil {
+			t.Fatal(err)
+		}
+		uConn, used, alternate := musePrepared(t, id, realityModeAuto)
+		native := realityNativePostQuantum(uConn, id)
+		if name == "chrome" && (!native || used != realityModePostQuantum || alternate != realityModeX25519) {
+			t.Fatalf("chrome: native %v used %v alternate %v", native, used, alternate)
+		}
+		if used == realityModePostQuantum {
+			museCheckPaired(t, uConn)
+		} else {
+			museCheckX25519Only(t, uConn)
+		}
+	}
+	// The other mode of a chrome hello is plain X25519.
+	id, _ := uTLSClientHelloID("chrome")
+	uConn, used, alternate := musePrepared(t, id, realityModeX25519)
+	if used != realityModeX25519 || alternate != realityModePostQuantum {
+		t.Fatalf("chrome forced X25519: used %v alternate %v", used, alternate)
+	}
+	museCheckX25519Only(t, uConn)
+}
+
+func TestMuseRealityModeFirefox(t *testing.T) {
+	id, _ := uTLSClientHelloID("firefox")
+	uConn, used, alternate := musePrepared(t, id, realityModeAuto)
+	if used != realityModeX25519 {
+		t.Fatalf("firefox: used %v", used)
+	}
+	museCheckX25519Only(t, uConn)
+	if alternate == realityModePostQuantum {
+		pq, used, _ := musePrepared(t, id, realityModePostQuantum)
+		if used != realityModePostQuantum {
+			t.Fatalf("firefox retry: used %v", used)
+		}
+		museCheckPaired(t, pq)
+	}
+}
+
+func museRandomizedIDs(t *testing.T, base utls.ClientHelloID, n int) []utls.ClientHelloID {
+	weights := utls.DefaultWeights
+	weights.TLSVersMax_Set_VersionTLS13 = 1
+	weights.FirstKeyShare_Set_CurveP256 = 0
+	ids := make([]utls.ClientHelloID, 0, n)
+	for i := 0; i < n; i++ {
+		id := base
+		seed, err := utls.NewPRNGSeed()
+		if err != nil {
+			t.Fatal(err)
+		}
+		id.Seed = seed
+		id.Weights = &weights
+		ids = append(ids, id)
+	}
+	return ids
+}
+
+func museCheckRandomized(t *testing.T, ids []utls.ClientHelloID) {
+	t.Helper()
+	sawPQ := false
+	for _, id := range ids {
+		uConn, used, alternate := musePrepared(t, id, realityModeAuto)
+		if used != realityModeX25519 {
+			t.Fatalf("%s: randomized spec used %v", id.Str(), used)
+		}
+		museCheckX25519Only(t, uConn)
+		if alternate == realityModePostQuantum {
+			sawPQ = true
+			pq, used, alternate := musePrepared(t, id, realityModePostQuantum)
+			if used != realityModePostQuantum || alternate != realityModeX25519 {
+				t.Fatalf("%s retry: used %v alternate %v", id.Str(), used, alternate)
+			}
+			museCheckPaired(t, pq)
+		} else {
+			_, used, _ := musePrepared(t, id, realityModePostQuantum)
+			if used != realityModeX25519 {
+				t.Fatalf("%s without a post-quantum share must stay X25519, used %v", id.Str(), used)
+			}
+		}
+	}
+	if !sawPQ {
+		t.Log("no seed produced a post-quantum share")
+	}
+}
+
+func TestMuseRealityModeRandomized(t *testing.T) {
+	id, _ := uTLSClientHelloID("randomized")
+	museCheckRandomized(t, append([]utls.ClientHelloID{id}, museRandomizedIDs(t, utls.HelloRandomized, 48)...))
+}
+
+func TestMuseRealityModeRandomizedNoALPN(t *testing.T) {
+	museCheckRandomized(t, museRandomizedIDs(t, utls.HelloRandomizedNoALPN, 48))
+}
+
+func TestMuseRealityModeCache(t *testing.T) {
+	c := &realityModeCache{}
+	if c.preferred("a") != realityModeAuto {
+		t.Fatal("empty cache")
+	}
+	c.failed("a", realityModePostQuantum, realityModeX25519, true)
+	if c.preferred("a") != realityModeAuto {
+		t.Fatal("a failure with a retry pending must not change the mode")
+	}
+	c.succeeded("a", realityModeX25519)
+	if c.preferred("a") != realityModeX25519 || c.preferred("b") != realityModeAuto {
+		t.Fatal("working mode not cached per server")
+	}
+	c.failed("a", realityModeX25519, realityModePostQuantum, false)
+	if c.preferred("a") != realityModePostQuantum {
+		t.Fatal("a failure without retry should switch the next connection")
+	}
+	c.failed("a", realityModePostQuantum, realityModeAuto, false)
+	if c.preferred("a") != realityModePostQuantum {
+		t.Fatal("no alternate: keep mode")
+	}
+}
+
+// museFakeServer reads one ClientHello per connection, records its groups and
+// closes the connection, so every handshake fails after the hello is sent.
+type museFakeServer struct {
+	access sync.Mutex
+	hellos [][2][]uint16
+	wg     sync.WaitGroup
+}
+
+func (s *museFakeServer) dial(t *testing.T) net.Conn {
+	client, server := net.Pipe()
+	s.wg.Add(1)
+	go func() {
+		defer s.wg.Done()
+		defer server.Close()
+		header := make([]byte, 5)
+		if _, err := io.ReadFull(server, header); err != nil {
+			return
+		}
+		body := make([]byte, binary.BigEndian.Uint16(header[3:]))
+		if _, err := io.ReadFull(server, body); err != nil {
+			return
+		}
+		groups, shares := museHelloGroups(t, body)
+		s.access.Lock()
+		s.hellos = append(s.hellos, [2][]uint16{groups, shares})
+		s.access.Unlock()
+	}()
+	return client
+}
+
+func (s *museFakeServer) modes() []realityKeyShareMode {
+	s.wg.Wait()
+	s.access.Lock()
+	defer s.access.Unlock()
+	var modes []realityKeyShareMode
+	for _, h := range s.hellos {
+		if museHas(h[1], museGroupPQ) {
+			modes = append(modes, realityModePostQuantum)
+		} else {
+			modes = append(modes, realityModeX25519)
+		}
+	}
+	return modes
+}
+
+func museRealityConfig(t *testing.T, server, fingerprint string) *RealityClientConfig {
+	t.Helper()
+	key, err := ecdh.X25519().GenerateKey(bytes.NewReader(bytes.Repeat([]byte{7}, 64)))
+	if err != nil {
+		t.Fatal(err)
+	}
+	config, err := NewRealityClient(context.Background(), logger.NOP(), server, option.OutboundTLSOptions{
+		Enabled:    true,
+		ServerName: "www.example.com",
+		UTLS:       &option.OutboundUTLSOptions{Enabled: true, Fingerprint: fingerprint},
+		Reality: &option.OutboundRealityOptions{
+			Enabled:   true,
+			PublicKey: base64.RawURLEncoding.EncodeToString(key.PublicKey().Bytes()),
+			ShortID:   "0123abcd",
+		},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return config.(*RealityClientConfig)
+}
+
+func TestMuseRealityRetryOtherMode(t *testing.T) {
+	config := museRealityConfig(t, "retry-chrome.test", "chrome")
+	fake := &museFakeServer{}
+	redials := 0
+	_, err := ClientHandshakeRedial(context.Background(), fake.dial(t), config, func(ctx context.Context) (net.Conn, error) {
+		redials++
+		return fake.dial(t), nil
+	})
+	if err == nil || !strings.Contains(err.Error(), "retry") {
+		t.Fatalf("want a failed retry, got %v", err)
+	}
+	modes := fake.modes()
+	if redials != 1 || len(modes) != 2 || modes[0] != realityModePostQuantum || modes[1] != realityModeX25519 {
+		t.Fatalf("want one retry PQ -> X25519, got redials %d hellos %v", redials, modes)
+	}
+	if got := realityModes.preferred(config.modeKey); got != realityModeAuto {
+		t.Fatalf("both modes failed: cache must stay unset, got %v", got)
+	}
+
+	// A server known to work with X25519 starts there and retries with PQ.
+	realityModes.succeeded(config.modeKey, realityModeX25519)
+	fake = &museFakeServer{}
+	_, err = ClientHandshakeRedial(context.Background(), fake.dial(t), config, func(ctx context.Context) (net.Conn, error) {
+		return fake.dial(t), nil
+	})
+	if err == nil {
+		t.Fatal("fake server cannot finish a handshake")
+	}
+	modes = fake.modes()
+	if len(modes) != 2 || modes[0] != realityModeX25519 || modes[1] != realityModePostQuantum {
+		t.Fatalf("cached X25519: want X25519 -> PQ, got %v", modes)
+	}
+}
+
+func TestMuseRealityRetryNoAlternate(t *testing.T) {
+	config := museRealityConfig(t, "retry-firefox.test", "firefox")
+	fake := &museFakeServer{}
+	redials := 0
+	_, err := ClientHandshakeRedial(context.Background(), fake.dial(t), config, func(ctx context.Context) (net.Conn, error) {
+		redials++
+		return fake.dial(t), nil
+	})
+	if err == nil {
+		t.Fatal("fake server cannot finish a handshake")
+	}
+	var hsErr *realityHandshakeError
+	if !errors.As(err, &hsErr) {
+		t.Fatalf("want a REALITY handshake error, got %T %v", err, err)
+	}
+	modes := fake.modes()
+	if hsErr.alternate == realityModeAuto && (redials != 0 || len(modes) != 1 || modes[0] != realityModeX25519) {
+		t.Fatalf("firefox without a post-quantum share: no retry expected, got redials %d hellos %v", redials, modes)
+	}
+}
+
+// Paths without a redial (one connection only) switch the next connection's mode.
+func TestMuseRealityRetryNextConnection(t *testing.T) {
+	config := museRealityConfig(t, "next-chrome.test", "chrome")
+	fake := &museFakeServer{}
+	for i := 0; i < 3; i++ {
+		if _, err := ClientHandshake(context.Background(), fake.dial(t), config); err == nil {
+			t.Fatal("fake server cannot finish a handshake")
+		}
+	}
+	modes := fake.modes()
+	want := []realityKeyShareMode{realityModePostQuantum, realityModeX25519, realityModePostQuantum}
+	for i := range want {
+		if len(modes) != 3 || modes[i] != want[i] {
+			t.Fatalf("want %v, got %v", want, modes)
+		}
+	}
+}
