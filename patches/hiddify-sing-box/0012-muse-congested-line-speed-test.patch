+// 穿云 1.10.3: one lost 测速 on a congested line no longer shows 超时 — the re-test decides.
+func TestMuseLatencyFirstFailureRetestsOnce(t *testing.T) {
+	// never measured: the re-test answers
+	var l museLatency
+	r, retest := l.apply(true, false, TimeoutDelay)
+	require.Equal(t, uint16(0), r)
+	require.True(t, retest)
+	r, retest = l.apply(false, true, 820)
+	require.Equal(t, uint16(820), r, "slow but working: the delay, not 超时")
+	require.False(t, retest)
+	require.Equal(t, 0, l.fails)
+
+	// timed out in an earlier 测速: one more chance when the user tests again
+	l = museLatency{value: TimeoutDelay}
+	r, retest = l.apply(true, false, TimeoutDelay)
+	require.Equal(t, uint16(0), r)
+	require.True(t, retest)
+	r, retest = l.apply(false, false, TimeoutDelay)
+	require.Equal(t, TimeoutDelay, r)
+	require.False(t, retest)
+
+	// a periodic miss of a node that already timed out stays timed out (no endless re-tests)
+	r, retest = l.apply(false, false, TimeoutDelay)
+	require.Equal(t, TimeoutDelay, r)
+	require.False(t, retest)
+
+	// the user taps 测速 again while the re-test is pending: that failure decides
+	l = museLatency{}
+	l.apply(true, false, TimeoutDelay)
+	r, retest = l.apply(true, false, TimeoutDelay)
