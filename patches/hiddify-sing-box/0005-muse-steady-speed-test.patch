+// 穿云 1.2.5: repeated 测速 taps refine one value instead of jumping between readings.
+func TestMuseLatencyRepeatedTapsAreSteady(t *testing.T) {
+	var l museLatency
+	r, _ := l.apply(true, true, 500)
+	require.Equal(t, uint16(500), r)
+	r, _ = l.apply(true, true, 300)
+	require.Equal(t, uint16(400), r) // median of {500, 300}
+	r, _ = l.apply(true, true, 320)
+	require.Equal(t, uint16(320), r) // median of {500, 300, 320}
+	r, _ = l.apply(true, true, 900) // one bad reading barely moves it
+	require.Equal(t, uint16(410), r) // median of {500, 300, 320, 900}
+	// old samples age out
+	l.samples[0].at = time.Now().Add(-2 * museSampleMaxAge)
+	require.Equal(t, uint16(320), l.addSamples(time.Now()))
+	// a timeout clears the window
+	l.apply(true, false, TimeoutDelay)
+	l.apply(true, false, TimeoutDelay)
+	require.Empty(t, l.samples)
+	r, _ = l.apply(true, true, 250)
+	require.Equal(t, uint16(250), r)
+}
