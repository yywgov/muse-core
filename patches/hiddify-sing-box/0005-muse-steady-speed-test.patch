 // picks by, so both always agree.
 
 import (
+	"sort"
 	"sync"
 	"time"
 )
 
 const (
-	museThoroughSamples = 3
+	museThoroughSamples = 5
+	// 穿云 1.2.5: samples kept per node across tests (the shown value is their median), and how
+	// long a sample stays relevant
+	museSampleWindow = 6
+	museSampleMaxAge = 3 * time.Minute
 	// weight of a new periodic sample in the smoothed value (0.4 = 40 %)
 	museSmoothNew = 0.4
 	// periodic failures in a row before a node with a good value counts as timed out
 	museFailuresToTimeout = 2
 	museRetestAfter       = 10 * time.Second
-	museMinProbeTimeout   = 1500 * time.Millisecond
+	museMinProbeTimeout   = 3 * time.Second
 )
 
 type museLatency struct {
-	value uint16 // 0 = none yet, TimeoutDelay = timed out
-	fails int
+	value   uint16 // 0 = none yet, TimeoutDelay = timed out
+	fails   int
+	samples []museSample
+}
+
+type museSample struct {
+	delay uint16
+	at    time.Time
+}
+
+// addSamples keeps the newest museSampleWindow samples younger than museSampleMaxAge and returns
+// their median, so tapping 测速 again refines the value instead of replacing it (timeout, 500,
+// 300 on three taps became one steady number).
+func (l *museLatency) addSamples(now time.Time, delays ...uint16) uint16 {
+	kept := l.samples[:0]
+	for _, s := range l.samples {
+		if now.Sub(s.at) <= museSampleMaxAge {
+			kept = append(kept, s)
+		}
+	}
+	for _, d := range delays {
+		if d > 0 && d < TimeoutDelay {
+			kept = append(kept, museSample{d, now})
+		}
+	}
+	if len(kept) > museSampleWindow {
+		kept = kept[len(kept)-museSampleWindow:]
+	}
+	l.samples = kept
+	if len(kept) == 0 {
+		return 0
+	}
+	ds := make([]uint16, len(kept))
+	for i, s := range kept {
+		ds[i] = s.delay
+	}
+	sort.Slice(ds, func(i, j int) bool { return ds[i] < ds[j] })
+	n := len(ds)
+	if n%2 == 1 {
+		return ds[n/2]
+	}
+	return uint16((uint32(ds[n/2-1]) + uint32(ds[n/2]) + 1) / 2)
 }
 
