diff --git a/common/monitoring/muse_latency.go b/common/monitoring/muse_latency.go
new file mode 100644
index 0000000..6d756fd
--- /dev/null
+++ b/common/monitoring/muse_latency.go
@@ -0,0 +1,115 @@
+package monitoring
+
+// muse (穿云 1.2.1): steadier node delays. The same node used to show 159 ms and then 226 ms,
+// and 自动最快 followed that jitter. Now:
+//   - a thorough test (测速, the first test of a session, the screen coming back on) throws away
+//     one warm-up probe and keeps the median of three probes run at the same time;
+//   - a periodic test (every few minutes, every 15 min with the screen off) is one probe, smoothed
+//     into the previous value (EWMA), so one slow sample moves it only part of the way;
+//   - one failed periodic probe keeps a good value and re-tests the node shortly; two failures in
+//     a row (or any failure without a good value) report the node as timed out.
+// The value is what the app shows and what the lowest-delay balancer (自动最快, 50 ms tolerance)
+// picks by, so both always agree.
+
+import (
+	"sync"
+	"time"
+)
+
+const (
+	museThoroughSamples = 3
+	// weight of a new periodic sample in the smoothed value (0.4 = 40 %)
+	museSmoothNew = 0.4
+	// periodic failures in a row before a node with a good value counts as timed out
+	museFailuresToTimeout = 2
+	museRetestAfter       = 10 * time.Second
+	museMinProbeTimeout   = 1500 * time.Millisecond
+)
+
+type museLatency struct {
+	value uint16 // 0 = none yet, TimeoutDelay = timed out
+	fails int
+}
+
+// apply takes one test result and returns the delay to report and whether to re-test soon.
+func (l *museLatency) apply(thorough bool, ok bool, delay uint16) (report uint16, retest bool) {
+	good := l.value > 0 && l.value < TimeoutDelay
+	switch {
+	case ok && thorough:
+		l.value, l.fails = delay, 0
+	case ok:
+		l.value, l.fails = museSmooth(l.value, delay), 0
+	case thorough || !good:
+		l.value, l.fails = TimeoutDelay, 0
+	default:
+		l.fails++
+		if l.fails >= museFailuresToTimeout {
+			l.value, l.fails = TimeoutDelay, 0
+		} else {
+			retest = true
+		}
+	}
+	return l.value, retest
+}
+
+// museSmooth blends a new periodic sample into the previous value.
+func museSmooth(prev, sample uint16) uint16 {
+	if prev == 0 || prev >= TimeoutDelay {
+		return sample
+	}
+	v := float64(prev)*(1-museSmoothNew) + float64(sample)*museSmoothNew
+	return uint16(v + 0.5)
+}
+
+// museProbeTimeout: after a warm-up of warm ms, a probe that takes far longer is a lost one.
+func museProbeTimeout(warm uint16, max time.Duration) time.Duration {
+	t := time.Duration(warm)*3*time.Millisecond + time.Second
+	if t < museMinProbeTimeout {
+		t = museMinProbeTimeout
+	}
+	if t > max {
+		t = max
+	}
+	return t
+}
+
+// museProbeMedian runs n probes at the same time and returns the median of those that answered.
+func museProbeMedian(probe func(time.Duration) (uint16, error), timeout time.Duration, n int) (uint16, error) {
+	var (
+		wg      sync.WaitGroup
+		mu      sync.Mutex
+		ok      []uint16
+		lastErr error
+	)
+	for i := 0; i < n; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			d, err := probe(timeout)
+			mu.Lock()
+			defer mu.Unlock()
+			if err != nil {
+				lastErr = err
+				return
+			}
+			ok = append(ok, d)
+		}()
+	}
+	wg.Wait()
+	if len(ok) == 0 {
+		return TimeoutDelay, lastErr
+	}
+	return medianDelay(ok), nil
+}
+
+// scheduleRetest tests a node again shortly after its first periodic failure.
+func (m *OutboundMonitoring) scheduleRetest(tag string) {
+	go func() {
+		select {
+		case <-m.ctx.Done():
+			return
+		case <-time.After(museRetestAfter):
+		}
+		m.enqueueTask(&testTask{outboundTag: tag, cycleID: m.cycleSeq + 1_000_000})
+	}()
+}
