+++ b/common/monitoring/muse_latency_test.go
@@ -0,0 +1,148 @@
+package monitoring
+
+import (
+	"context"
+	"errors"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common/json/badoption"
+	M "github.com/sagernet/sing/common/metadata"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestMuseLatencyThoroughSetsMedian(t *testing.T) {
+	var l museLatency
+	r, retest := l.apply(true, true, 159)
+	require.Equal(t, uint16(159), r)
+	require.False(t, retest)
+	// a thorough failure (the user pressed 测速) reports the timeout at once
+	r, _ = l.apply(true, false, TimeoutDelay)
+	require.Equal(t, TimeoutDelay, r)
+}
+
+func TestMuseLatencyPeriodicSmoothing(t *testing.T) {
+	l := museLatency{value: 160}
+	r, _ := l.apply(false, true, 226) // one slow sample moves it only part of the way
+	require.Equal(t, uint16(186), r)  // 160*0.6 + 226*0.4 = 186.4
+	r, _ = l.apply(false, true, 160)
+	require.Equal(t, uint16(176), r)
+	require.Equal(t, uint16(200), museSmooth(0, 200))
+	require.Equal(t, uint16(200), museSmooth(TimeoutDelay, 200))
+}
+
+func TestMuseLatencyPeriodicFailureKeepsGoodValue(t *testing.T) {
+	l := museLatency{value: 180}
+	r, retest := l.apply(false, false, TimeoutDelay)
+	require.Equal(t, uint16(180), r, "one lost probe does not wipe a good value")
+	require.True(t, retest, "but the node is re-tested soon")
+	r, _ = l.apply(false, true, 200) // recovered: failures reset
+	require.Equal(t, uint16(188), r)
+	l.apply(false, false, TimeoutDelay)
+	r, retest = l.apply(false, false, TimeoutDelay)
+	require.Equal(t, TimeoutDelay, r, "two failures in a row: timed out")
+	require.False(t, retest)
+	// without a good value a failure is a timeout right away
+	var fresh museLatency
+	r, _ = fresh.apply(false, false, TimeoutDelay)
+	require.Equal(t, TimeoutDelay, r)
+}
+
+func TestMuseProbeMedian(t *testing.T) {
+	var i atomic.Int32
+	values := []uint16{150, 400, 160}
+	d, err := museProbeMedian(func(time.Duration) (uint16, error) {
+		return values[i.Add(1)-1], nil
+	}, time.Second, 3)
+	require.NoError(t, err)
+	require.Equal(t, uint16(160), d)
+
+	i.Store(0)
+	d, err = museProbeMedian(func(time.Duration) (uint16, error) {
+		if i.Add(1) == 2 {
+			return 0, errors.New("lost")
+		}
+		return 200, nil
+	}, time.Second, 3)
+	require.NoError(t, err)
+	require.Equal(t, uint16(200), d, "a lost probe is left out")
+
+	_, err = museProbeMedian(func(time.Duration) (uint16, error) { return 0, errors.New("down") }, time.Second, 3)
+	require.Error(t, err)
+}
+
+func TestMuseProbeTimeout(t *testing.T) {
+	require.Equal(t, museMinProbeTimeout, museProbeTimeout(50, 5*time.Second))
+	require.Equal(t, 2500*time.Millisecond, museProbeTimeout(500, 5*time.Second))
+	require.Equal(t, 5*time.Second, museProbeTimeout(3000, 5*time.Second))
+}
+
+// The thorough test (warm-up + 3 concurrent probes) of 30 nodes with 10 workers must not take
+// much longer than the old single probe: about two round trips per node instead of one.
+func TestMuseThoroughTestTiming(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusNoContent)
+	}))
+	defer server.Close()
+	serverAddr := M.ParseSocksaddr(server.Listener.Addr().String())
+	var dialer net.Dialer
+	const nodes = 30
+	var outbounds []adapter.Outbound
+	var tags []string
+	for n := 0; n < nodes; n++ {
+		tag := "node" + string(rune('A'+n))
+		tags = append(tags, tag)
+		outbounds = append(outbounds, &fakeOutbound{tag: tag, dial: func(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
+			if destination != serverAddr {
+				return nil, errors.New("unreachable")
+			}
+			select { // a 120 ms connect, like a real node
+			case <-time.After(120 * time.Millisecond):
+			case <-ctx.Done():
+				return nil, ctx.Err()
+			}
+			return dialer.DialContext(ctx, network, destination.String())
+		}})
+	}
+	m := newTestMonitor(t, nil, option.MonitoringOptions{
+		URLs:           []string{server.URL + "/generate_204"},
+		URLTestTimeout: badoption.Duration(5 * time.Second),
+	}, outbounds...)
+	require.NoError(t, m.Start(adapter.StartStateInitialize))
+
+	run := func(thorough bool) time.Duration {
+		start := time.Now()
+		work := make(chan string)
+		var wg sync.WaitGroup
+		for w := 0; w < defaultWorkerCount; w++ {
+			wg.Add(1)
+			go func() {
+				defer wg.Done()
+				for tag := range work {
+					h, err := m.tester(context.Background(), tag, thorough)
+					require.NoError(t, err)
+					require.Less(t, h.Delay, TimeoutDelay)
+				}
+			}()
+		}
+		for _, tag := range tags {
+			work <- tag
+		}
+		close(work)
+		wg.Wait()
+		return time.Since(start)
+	}
+	single := run(false)
+	thorough := run(true)
+	t.Logf("muse timing: %d nodes, %d workers: single probe %v, thorough (warm-up + 3 concurrent) %v, ratio %.2f",
+		nodes, defaultWorkerCount, single.Round(time.Millisecond), thorough.Round(time.Millisecond), float64(thorough)/float64(single))
+	require.Less(t, thorough, single*3, "thorough test stays within ~2 round trips per node")
+}
