diff --git a/common/monitoring/muse_screen.go b/common/monitoring/muse_screen.go
new file mode 100644
index 00000000..0f842458
--- /dev/null
+++ b/common/monitoring/muse_screen.go
@@ -0,0 +1,65 @@
+package monitoring
+
+// muse (穿云): node tests follow the phone's screen. While the screen is off the regular test
+// cycle runs at most every ScreenOffInterval (saves battery and data on a sleeping phone);
+// when the screen comes back on every node is tested again at once, so the numbers and the
+// 自动最快 pick are fresh by the time the user looks.
+
+import (
+	"sync"
+	"sync/atomic"
+	"time"
+)
+
+const ScreenOffInterval = 15 * time.Minute
+
+var (
+	museScreenOff atomic.Bool
+	museMonitors  sync.Map // *OutboundMonitoring -> struct{}
+)
+
+// SetScreenOn is called by the platform when the screen turns on or off.
+func SetScreenOn(on bool) {
+	if !on {
+		museScreenOff.Store(true)
+		return
+	}
+	if !museScreenOff.Swap(false) {
+		return
+	}
+	museMonitors.Range(func(key, _ any) bool {
+		key.(*OutboundMonitoring).museRetestNow()
+		return true
+	})
+}
+
+// ScreenOff reports whether the platform said the screen is off.
+func ScreenOff() bool {
+	return museScreenOff.Load()
+}
+
+func museRegister(m *OutboundMonitoring) {
+	museMonitors.Store(m, struct{}{})
+}
+
+func museUnregister(m *OutboundMonitoring) {
+	museMonitors.Delete(m)
+}
+
+// museSkipCycle: a regular cycle is skipped while the screen is off and the last one is recent.
+func museSkipCycle(m *OutboundMonitoring) bool {
+	if !museScreenOff.Load() {
+		return false
+	}
+	last := m.lastCycle.Load()
+	return !last.IsZero() && time.Since(last) < ScreenOffInterval
+}
+
+func (m *OutboundMonitoring) museRetestNow() {
+	if !m.started || m.ctx.Err() != nil {
+		return
+	}
+	m.forceAll.Store(true)
+	m.Touch()
+	m.startCycleOnce()
+}
diff --git a/common/monitoring/muse_screen_test.go b/common/monitoring/muse_screen_test.go
new file mode 100644
index 00000000..4b59c982
--- /dev/null
+++ b/common/monitoring/muse_screen_test.go
@@ -0,0 +1,30 @@
+package monitoring
+
+import (
+	"testing"
+	"time"
+)
+
+func TestMuseScreenOffSkipsCycles(t *testing.T) {
+	m := &OutboundMonitoring{}
+	SetScreenOn(true)
+	if museSkipCycle(m) {
+		t.Fatal("screen on must never skip")
+	}
+	SetScreenOn(false)
+	if museSkipCycle(m) {
+		t.Fatal("no cycle yet: must run")
+	}
+	m.lastCycle.Store(time.Now().Add(-5 * time.Minute))
+	if !museSkipCycle(m) {
+		t.Fatal("screen off, 5 min since last cycle: must skip")
+	}
+	m.lastCycle.Store(time.Now().Add(-16 * time.Minute))
+	if museSkipCycle(m) {
+		t.Fatal("screen off, 16 min since last cycle: must run")
+	}
+	SetScreenOn(true) // m is not registered/started: nothing to retest
+	if ScreenOff() {
+		t.Fatal("screen should be on")
+	}
+}
