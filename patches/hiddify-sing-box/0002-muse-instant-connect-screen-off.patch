diff --git a/protocol/group/balancer/balancer.go b/protocol/group/balancer/balancer.go
index fee64339..ed102ce3 100644
--- a/protocol/group/balancer/balancer.go
+++ b/protocol/group/balancer/balancer.go
@@ -129,6 +129,16 @@ func (s *Balancer) worker() {
 	}
 	defer s.monitor.UnsubscribeGroup(s.Tag(), observer)
 
+	// muse (穿云 秒连): start on the node that was fastest last time (results kept in the cache
+	// file) instead of the first node, until this session's own tests come in. Nothing is
+	// interrupted: this runs before the first connection is made through the group.
+	if _, ok := s.strategyFn.(*LowestDelay); ok {
+		history := s.monitor.OutboundsHistory(s.Tag())
+		if hasUsableDelay(history) {
+			s.strategyFn.UpdateOutboundsInfo(history)
+		}
+	}
+
 	for {
 		select {
 		case <-s.close:
@@ -266,3 +276,13 @@ func (s *Balancer) PreMatchFlow(network string, destination netip.Addr) adapter.
 	}
 	return adapter.PreMatchContinue
 }
+
+// muse: whether any node has a real (non-timeout) delay, e.g. one kept from the last session.
+func hasUsableDelay(history map[string]*adapter.URLTestHistory) bool {
+	for _, his := range history {
+		if his != nil && his.Delay > 0 && his.Delay < monitoring.TimeoutDelay {
+			return true
+		}
+	}
+	return false
+}
diff --git a/protocol/group/balancer/muse_seed_test.go b/protocol/group/balancer/muse_seed_test.go
new file mode 100644
index 00000000..2bb6ba22
--- /dev/null
+++ b/protocol/group/balancer/muse_seed_test.go
@@ -0,0 +1,38 @@
+package balancer
+
+import (
+	"testing"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/monitoring"
+	"github.com/sagernet/sing-box/option"
+	"github.com/stretchr/testify/require"
+)
+
+// muse 秒连: cached results (from the last session) pick the start node; no data keeps the first.
+func TestMuseSeedFromCache(t *testing.T) {
+	a, b, c := newFake("a"), newFake("b"), newFake("c")
+	ld := NewLowestDelay([]adapter.Outbound{a, b, c}, option.BalancerOutboundOptions{Tolerance: 50})
+	require.Equal(t, "a", ld.Now())
+
+	empty := map[string]*adapter.URLTestHistory{"a": {}, "b": {}, "c": {}}
+	require.False(t, hasUsableDelay(empty))
+
+	cached := map[string]*adapter.URLTestHistory{
+		"a": {Delay: 0, IsFromCache: true},
+		"b": {Delay: 300, IsFromCache: true},
+		"c": {Delay: 120, IsFromCache: true},
+	}
+	require.True(t, hasUsableDelay(cached))
+	ld.UpdateOutboundsInfo(cached)
+	require.Equal(t, "c", ld.Now())
+
+	// this session's first real result for c keeps it; an untested b stays behind (cache penalty)
+	fresh := map[string]*adapter.URLTestHistory{
+		"a": {Delay: monitoring.TimeoutDelay},
+		"b": {Delay: 300, IsFromCache: true},
+		"c": {Delay: 150},
+	}
+	ld.UpdateOutboundsInfo(fresh)
+	require.Equal(t, "c", ld.Now())
+}
