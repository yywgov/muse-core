+package dns
+
+import (
+	"context"
+	"errors"
+	"net"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/service"
+
+	mDNS "github.com/miekg/dns"
+	"github.com/stretchr/testify/require"
+)
+
+// museTestTransport answers A queries with a fixed address after a short delay.
+type museTestTransport struct {
+	TransportAdapter
+	answer string
+	err    error
+	member string // when set, acts as a group: notes this member as the answering server
+	calls  int
+}
+
+func newMuseTestTransport(transportType, tag, server string, port uint16) *museTestTransport {
+	return &museTestTransport{
+		TransportAdapter: NewTransportAdapterWithRemoteOptions(transportType, tag, option.RemoteDNSServerOptions{
+			DNSServerAddressOptions: option.DNSServerAddressOptions{Server: server, ServerPort: port},
+		}),
+		answer: "1.2.3.4",
+	}
+}
+
+func (t *museTestTransport) Start(adapter.StartStage) error { return nil }
+func (t *museTestTransport) Close() error                   { return nil }
+func (t *museTestTransport) Reset()                         {}
+
+func (t *museTestTransport) Exchange(ctx context.Context, message *mDNS.Msg) (*mDNS.Msg, error) {
+	t.calls++
+	time.Sleep(2 * time.Millisecond)
+	if t.err != nil {
+		return nil, t.err
+	}
+	if t.member != "" {
+		MuseNoteServer(ctx, t.member)
+	}
+	response := new(mDNS.Msg)
+	response.SetReply(message)
+	response.Answer = []mDNS.RR{&mDNS.A{
+		Hdr: mDNS.RR_Header{Name: message.Question[0].Name, Rrtype: mDNS.TypeA, Class: mDNS.ClassINET, Ttl: 60},
+		A:   net.ParseIP(t.answer),
+	}}
+	return response, nil
+}
+
+func (t *museTestTransport) ExchangeAsync(ctx context.Context, message *mDNS.Msg, callback func(*mDNS.Msg, error)) {
+	go func() {
+		response, err := t.Exchange(ctx, message)
+		callback(response, err)
+	}()
+}
+
+type museCollector struct {
+	access  sync.Mutex
+	queries []MuseQuery
+}
+
+func (c *museCollector) hook(query *MuseQuery) {
+	c.access.Lock()
+	c.queries = append(c.queries, *query)
+	c.access.Unlock()
+}
+
+func (c *museCollector) all() []MuseQuery {
+	c.access.Lock()
+	defer c.access.Unlock()
+	return append([]MuseQuery(nil), c.queries...)
+}
+
+func museTestClient(ctx context.Context, disableCache bool) *Client {
+	return NewClient(ClientOptions{
+		Context:      ctx,
+		DisableCache: disableCache,
+		Logger:       log.NewNOPFactory().Logger(),
+	})
+}
+
+func museQuestion(domain string) *mDNS.Msg {
+	message := new(mDNS.Msg)
+	message.SetQuestion(mDNS.Fqdn(domain), mDNS.TypeA)
+	return message
+}
+
+func TestMuseQueryNoHookRecordsNothing(t *testing.T) {
+	SetMuseQueryHook(nil)
+	transport := newMuseTestTransport("udp", "dns-direct", "223.5.5.5", 0)
+	client := museTestClient(context.Background(), false)
+	response, err := client.Exchange(context.Background(), transport, museQuestion("a.example"), adapter.DNSQueryOptions{}, nil)
+	require.NoError(t, err)
+	require.Len(t, response.Answer, 1)
+	require.True(t, museStart().IsZero(), "no hook -> no timing work")
+	require.Nil(t, museTraceFrom(context.Background()))
+}
+
+func TestMuseQueryExchangeAndCacheHit(t *testing.T) {
+	collector := &museCollector{}
+	SetMuseQueryHook(collector.hook)
+	defer SetMuseQueryHook(nil)
+	transport := newMuseTestTransport("udp", "dns-direct", "223.5.5.5", 0)
+	client := museTestClient(context.Background(), false)
+	_, err := client.Exchange(context.Background(), transport, museQuestion("b.example"), adapter.DNSQueryOptions{}, nil)
+	require.NoError(t, err)
+	_, err = client.Exchange(context.Background(), transport, museQuestion("b.example"), adapter.DNSQueryOptions{}, nil)
+	require.NoError(t, err)
+	require.Equal(t, 1, transport.calls, "second query served from cache")
+	queries := collector.all()
+	require.Len(t, queries, 2)
+	first := queries[0]
+	require.Equal(t, "b.example", first.Domain)
+	require.Equal(t, "A", first.Type)
+	require.Equal(t, "dns-direct", first.Server)
+	require.Equal(t, "udp", first.ServerType)
+	require.Equal(t, "223.5.5.5", first.Address)
+	require.Equal(t, []string{"1.2.3.4"}, first.Answers)
+	require.Equal(t, "NOERROR", first.Rcode)
+	require.False(t, first.Cached)
+	require.GreaterOrEqual(t, first.Duration, 2*time.Millisecond)
+	require.False(t, first.Time.IsZero())
+	require.True(t, queries[1].Cached)
+	require.Equal(t, []string{"1.2.3.4"}, queries[1].Answers)
+}
+
+func TestMuseQueryLookupCached(t *testing.T) {
+	collector := &museCollector{}
+	SetMuseQueryHook(collector.hook)
+	defer SetMuseQueryHook(nil)
+	transport := newMuseTestTransport("tcp", "dns-direct-group-1", "119.29.29.29", 0)
+	client := museTestClient(context.Background(), false)
+	options := adapter.DNSQueryOptions{LookupStrategy: C.DomainStrategyIPv4Only}
+	for i := 0; i < 2; i++ {
+		addresses, err := client.Lookup(context.Background(), transport, "c.example", options, nil)
+		require.NoError(t, err)
+		require.Len(t, addresses, 1)
+	}
+	queries := collector.all()
+	require.Len(t, queries, 2)
+	require.Equal(t, "tcp://119.29.29.29", queries[0].Address)
+	require.False(t, queries[0].Cached)
+	require.True(t, queries[1].Cached)
+}
+
+func TestMuseQueryErrorAndAsync(t *testing.T) {
+	collector := &museCollector{}
+	SetMuseQueryHook(collector.hook)
+	defer SetMuseQueryHook(nil)
+	transport := newMuseTestTransport("https", "dns-remote", "8.8.8.8", 0)
+	transport.err = errors.New("boom")
+	client := museTestClient(context.Background(), true)
+	_, err := client.Exchange(context.Background(), transport, museQuestion("d.example"), adapter.DNSQueryOptions{}, nil)
+	require.Error(t, err)
+	done := make(chan struct{})
+	client.ExchangeAsync(context.Background(), transport, museQuestion("e.example"), adapter.DNSQueryOptions{}, nil, func(*mDNS.Msg, error) { close(done) })
+	<-done
+	queries := collector.all()
+	require.Len(t, queries, 2)
+	for _, query := range queries {
+		require.Equal(t, "boom", query.Error)
+		require.Empty(t, query.Answers)
+		require.Equal(t, "https://8.8.8.8", query.Address)
+	}
+}
+
+func TestMuseQueryGroupMember(t *testing.T) {
+	collector := &museCollector{}
+	SetMuseQueryHook(collector.hook)
+	defer SetMuseQueryHook(nil)
+	member := newMuseTestTransport("tcp", "dns-direct-group-1", "119.29.29.29", 0)
+	group := &museTestTransport{
+		TransportAdapter: NewTransportAdapter("group", "dns-direct-group", nil),
+		answer:           "5.6.7.8",
+		member:           member.Tag(),
+	}
+	manager := &fakeDNSTransportManager{transports: map[string]adapter.DNSTransport{member.Tag(): member, group.Tag(): group}}
+	ctx := service.ContextWith[adapter.DNSTransportManager](context.Background(), manager)
+	client := museTestClient(ctx, true)
+	_, err := client.Exchange(context.Background(), group, museQuestion("f.example"), adapter.DNSQueryOptions{}, nil)
+	require.NoError(t, err)
+	queries := collector.all()
+	require.Len(t, queries, 1)
+	require.Equal(t, "dns-direct-group-1", queries[0].Server)
+	require.Equal(t, "dns-direct-group", queries[0].Group)
+	require.Equal(t, "tcp", queries[0].ServerType)
+	require.Equal(t, "tcp://119.29.29.29", queries[0].Address)
+	require.Equal(t, []string{"5.6.7.8"}, queries[0].Answers)
+}
+
+func TestMuseQueryHookInstalledMidQuerySkipped(t *testing.T) {
+	SetMuseQueryHook(nil)
+	collector := &museCollector{}
+	client := museTestClient(context.Background(), true)
+	// a query that began before recording started has no start time and is not reported
+	client.museRecord(context.Background(), time.Time{}, newMuseTestTransport("udp", "x", "1.1.1.1", 0), mDNS.Question{Name: "g.example.", Qtype: mDNS.TypeA}, nil, false, false, nil)
+	SetMuseQueryHook(collector.hook)
+	defer SetMuseQueryHook(nil)
+	client.museRecord(context.Background(), time.Time{}, newMuseTestTransport("udp", "x", "1.1.1.1", 0), mDNS.Question{Name: "g.example.", Qtype: mDNS.TypeA}, nil, false, false, nil)
+	require.Empty(t, collector.all())
+}
+
+func TestMuseQueryClearOnlyOwnHook(t *testing.T) {
+	first := &museCollector{}
+	SetMuseQueryHook(first.hook)
+	own := LoadMuseQueryHook()
+	second := &museCollector{}
+	SetMuseQueryHook(second.hook)
+	require.False(t, ClearMuseQueryHook(own), "a newer hook is kept")
+	require.True(t, ClearMuseQueryHook(LoadMuseQueryHook()))
+	require.Nil(t, LoadMuseQueryHook())
+}
+
+func TestMuseFormatAddress(t *testing.T) {
+	require.Equal(t, "223.5.5.5", museFormatAddress("223.5.5.5", 0, "udp"))
+	require.Equal(t, "223.5.5.5", museFormatAddress("223.5.5.5", 53, "udp"))
+	require.Equal(t, "223.5.5.5:5353", museFormatAddress("223.5.5.5", 5353, "udp"))
+	require.Equal(t, "tcp://119.29.29.29", museFormatAddress("119.29.29.29", 0, "tcp"))
+	require.Equal(t, "tls://8.8.8.8", museFormatAddress("8.8.8.8", 853, "tls"))
+	require.Equal(t, "https://dns.google", museFormatAddress("dns.google", 443, "https"))
+	require.Equal(t, "[2400:3200::1]", museFormatAddress("2400:3200::1", 0, "udp"))
+	require.Equal(t, "", museFormatAddress("", 0, "local"))
+}
