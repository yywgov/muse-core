diff --git a/experimental/clashapi/muse_dns.go b/experimental/clashapi/muse_dns.go
new file mode 100644
index 000000000..1dff299f9
--- /dev/null
+++ b/experimental/clashapi/muse_dns.go
@@ -0,0 +1,260 @@
+package clashapi
+
+// 穿云 core: DNS query view.
+//
+//   GET    /dns/queries   websocket: first frame = buffered queries (oldest first),
+//                         then one frame per batch of new queries; plain GET = snapshot
+//   DELETE /dns/queries   clear the buffer
+//
+// Queries are recorded only while at least one websocket is open: the first
+// subscriber installs the DNS client hook, the last one removes it. The buffer is a
+// fixed ring (museDNSCapacity) kept for the next subscriber.
+
+import (
+	"bytes"
+	"context"
+	"net/http"
+	"sync"
+	"time"
+
+	"github.com/sagernet/sing-box/dns"
+	"github.com/sagernet/sing/common/json"
+	"github.com/sagernet/ws"
+	"github.com/sagernet/ws/wsutil"
+
+	"github.com/go-chi/render"
+)
+
+const (
+	museDNSCapacity      = 500
+	museDNSSubscriberBuf = 256
+)
+
+// MuseDNSQuery is the wire form of one query.
+type MuseDNSQuery struct {
+	ID         uint64   `json:"id"`
+	Time       int64    `json:"time"` // unix milliseconds
+	Domain     string   `json:"domain"`
+	Type       string   `json:"type"`
+	Server     string   `json:"server"`
+	ServerType string   `json:"serverType,omitempty"`
+	Address    string   `json:"address,omitempty"`
+	Group      string   `json:"group,omitempty"`
+	Answers    []string `json:"answers"`
+	Rcode      string   `json:"rcode,omitempty"`
+	Elapsed    float64  `json:"elapsed"` // milliseconds
+	Cached     bool     `json:"cached"`
+	Optimistic bool     `json:"optimistic,omitempty"`
+	Error      string   `json:"error,omitempty"`
+}
+
+type museDNSSubscriber struct {
+	ch chan MuseDNSQuery
+}
+
+type museDNSRecorder struct {
+	access      sync.Mutex
+	ring        []MuseDNSQuery
+	next        int
+	full        bool
+	nextID      uint64
+	subscribers map[*museDNSSubscriber]struct{}
+	hook        *dns.MuseQueryHook
+}
+
+func newMuseDNSRecorder(capacity int) *museDNSRecorder {
+	return &museDNSRecorder{
+		ring:        make([]MuseDNSQuery, capacity),
+		subscribers: make(map[*museDNSSubscriber]struct{}),
+	}
+}
+
+func (r *museDNSRecorder) record(query *dns.MuseQuery) {
+	r.access.Lock()
+	defer r.access.Unlock()
+	if len(r.subscribers) == 0 {
+		return
+	}
+	r.nextID++
+	answers := query.Answers
+	if answers == nil {
+		answers = []string{}
+	}
+	item := MuseDNSQuery{
+		ID:         r.nextID,
+		Time:       query.Time.UnixMilli(),
+		Domain:     query.Domain,
+		Type:       query.Type,
+		Server:     query.Server,
+		ServerType: query.ServerType,
+		Address:    query.Address,
+		Group:      query.Group,
+		Answers:    answers,
+		Rcode:      query.Rcode,
+		Elapsed:    float64(query.Duration.Microseconds()) / 1000,
+		Cached:     query.Cached,
+		Optimistic: query.Optimistic,
+		Error:      query.Error,
+	}
+	r.ring[r.next] = item
+	r.next++
+	if r.next == len(r.ring) {
+		r.next = 0
+		r.full = true
+	}
+	for subscriber := range r.subscribers {
+		select {
+		case subscriber.ch <- item:
+		default: // slow reader: drop rather than block DNS
+		}
+	}
+}
+
+// snapshot returns buffered queries, oldest first.
+func (r *museDNSRecorder) snapshot() []MuseDNSQuery {
+	r.access.Lock()
+	defer r.access.Unlock()
+	return r.snapshotLocked()
+}
+
+func (r *museDNSRecorder) snapshotLocked() []MuseDNSQuery {
+	var out []MuseDNSQuery
+	if r.full {
+		out = make([]MuseDNSQuery, 0, len(r.ring))
+		out = append(out, r.ring[r.next:]...)
+		out = append(out, r.ring[:r.next]...)
+	} else {
+		out = make([]MuseDNSQuery, r.next)
+		copy(out, r.ring[:r.next])
+	}
+	return out
+}
+
+func (r *museDNSRecorder) clear() {
+	r.access.Lock()
+	defer r.access.Unlock()
+	for i := range r.ring {
+		r.ring[i] = MuseDNSQuery{}
+	}
+	r.next = 0
+	r.full = false
+}
+
+// subscribe returns the buffered queries and a live channel. The snapshot and the
+// registration happen under one lock so no query is lost or sent twice.
+func (r *museDNSRecorder) subscribe() (*museDNSSubscriber, []MuseDNSQuery) {
+	r.access.Lock()
+	defer r.access.Unlock()
+	subscriber := &museDNSSubscriber{ch: make(chan MuseDNSQuery, museDNSSubscriberBuf)}
+	r.subscribers[subscriber] = struct{}{}
+	if len(r.subscribers) == 1 {
+		dns.SetMuseQueryHook(r.record)
+		r.hook = dns.LoadMuseQueryHook()
+	}
+	return subscriber, r.snapshotLocked()
+}
+
+func (r *museDNSRecorder) unsubscribe(subscriber *museDNSSubscriber) {
+	r.access.Lock()
+	defer r.access.Unlock()
+	if _, loaded := r.subscribers[subscriber]; !loaded {
+		return
+	}
+	delete(r.subscribers, subscriber)
+	if len(r.subscribers) == 0 && r.hook != nil {
+		dns.ClearMuseQueryHook(r.hook)
+		r.hook = nil
+	}
+}
+
+// close drops every subscriber and removes the hook (server shutdown).
+func (r *museDNSRecorder) close() {
+	r.access.Lock()
+	defer r.access.Unlock()
+	for subscriber := range r.subscribers {
+		delete(r.subscribers, subscriber)
+	}
+	if r.hook != nil {
+		dns.ClearMuseQueryHook(r.hook)
+		r.hook = nil
+	}
+}
+
+func (r *museDNSRecorder) subscriberCount() int {
+	r.access.Lock()
+	defer r.access.Unlock()
+	return len(r.subscribers)
+}
+
+func museDNSQueries(ctx context.Context, recorder *museDNSRecorder) func(w http.ResponseWriter, req *http.Request) {
+	return func(w http.ResponseWriter, req *http.Request) {
+		if req.Header.Get("Upgrade") != "websocket" {
+			render.JSON(w, req, recorder.snapshot())
+			return
+		}
+		conn, _, _, err := ws.UpgradeHTTP(req, w)
+		if err != nil {
+			return
+		}
+		defer conn.Close()
+		subscriber, initial := recorder.subscribe()
+		defer recorder.unsubscribe(subscriber)
+
+		// one reader per open socket: notices the client going away (and answers pings)
+		gone := make(chan struct{})
+		go func() {
+			defer close(gone)
+			for {
+				if _, _, readErr := wsutil.ReadClientData(conn); readErr != nil {
+					return
+				}
+			}
+		}()
+
+		buf := &bytes.Buffer{}
+		send := func(items []MuseDNSQuery) error {
+			buf.Reset()
+			if items == nil {
+				items = []MuseDNSQuery{}
+			}
+			if encodeErr := json.NewEncoder(buf).Encode(items); encodeErr != nil {
+				return encodeErr
+			}
+			_ = conn.SetWriteDeadline(time.Now().Add(10 * time.Second))
+			return wsutil.WriteServerText(conn, buf.Bytes())
+		}
+		if send(initial) != nil {
+			return
+		}
+		batch := make([]MuseDNSQuery, 0, 64)
+		for {
+			select {
+			case <-ctx.Done():
+				return
+			case <-gone:
+				return
+			case item := <-subscriber.ch:
+				batch = append(batch[:0], item)
+			drain:
+				for len(batch) < cap(batch) {
+					select {
+					case more := <-subscriber.ch:
+						batch = append(batch, more)
+					default:
+						break drain
+					}
+				}
+				if send(batch) != nil {
+					return
+				}
+			}
+		}
+	}
+}
+
+func museClearDNSQueries(recorder *museDNSRecorder) func(w http.ResponseWriter, req *http.Request) {
+	return func(w http.ResponseWriter, req *http.Request) {
+		recorder.clear()
+		render.NoContent(w, req)
+	}
+}
diff --git a/experimental/clashapi/muse_dns_test.go b/experimental/clashapi/muse_dns_test.go
new file mode 100644
index 000000000..07d166704
--- /dev/null
+++ b/experimental/clashapi/muse_dns_test.go
@@ -0,0 +1,154 @@
+package clashapi
+
+import (
+	"context"
+	"encoding/json"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/dns"
+	"github.com/sagernet/ws"
+	"github.com/sagernet/ws/wsutil"
+
+	"github.com/stretchr/testify/require"
+)
+
+func museQuery(domain string) *dns.MuseQuery {
+	return &dns.MuseQuery{
+		Time:     time.UnixMilli(1700000000000),
+		Domain:   domain,
+		Type:     "A",
+		Server:   "dns-direct",
+		Address:  "223.5.5.5",
+		Answers:  []string{"1.2.3.4"},
+		Rcode:    "NOERROR",
+		Duration: 1500 * time.Microsecond,
+	}
+}
+
+func museRecordViaHook(domain string) {
+	if hook := dns.LoadMuseQueryHook(); hook != nil {
+		(*hook)(museQuery(domain))
+	}
+}
+
+func TestMuseDNSRecorderOnlyWhileSubscribed(t *testing.T) {
+	dns.SetMuseQueryHook(nil)
+	recorder := newMuseDNSRecorder(4)
+	require.Nil(t, dns.LoadMuseQueryHook(), "no subscriber -> no hook")
+	recorder.record(museQuery("ignored.example"))
+	require.Empty(t, recorder.snapshot(), "nothing recorded without subscriber")
+
+	first, initial := recorder.subscribe()
+	require.Empty(t, initial)
+	require.NotNil(t, dns.LoadMuseQueryHook())
+	second, _ := recorder.subscribe()
+	recorder.unsubscribe(first)
+	require.NotNil(t, dns.LoadMuseQueryHook(), "hook stays while one subscriber is left")
+	museRecordViaHook("a.example")
+	recorder.unsubscribe(second)
+	require.Nil(t, dns.LoadMuseQueryHook(), "last subscriber removes the hook")
+	recorder.unsubscribe(second) // twice is harmless
+	museRecordViaHook("b.example")
+	snapshot := recorder.snapshot()
+	require.Len(t, snapshot, 1, "buffer kept for the next subscriber")
+	require.Equal(t, "a.example", snapshot[0].Domain)
+}
+
+func TestMuseDNSRecorderRing(t *testing.T) {
+	dns.SetMuseQueryHook(nil)
+	recorder := newMuseDNSRecorder(3)
+	subscriber, _ := recorder.subscribe()
+	defer recorder.unsubscribe(subscriber)
+	for _, domain := range []string{"1", "2", "3", "4", "5"} {
+		recorder.record(museQuery(domain))
+	}
+	snapshot := recorder.snapshot()
+	require.Len(t, snapshot, 3)
+	require.Equal(t, []string{"3", "4", "5"}, []string{snapshot[0].Domain, snapshot[1].Domain, snapshot[2].Domain})
+	require.Equal(t, uint64(5), snapshot[2].ID)
+	require.Equal(t, 1.5, snapshot[2].Elapsed)
+	require.Equal(t, int64(1700000000000), snapshot[2].Time)
+	recorder.clear()
+	require.Empty(t, recorder.snapshot())
+	// a slow reader never blocks DNS: the channel just drops
+	for i := 0; i < museDNSSubscriberBuf+10; i++ {
+		recorder.record(museQuery("flood"))
+	}
+	require.Len(t, subscriber.ch, museDNSSubscriberBuf)
+}
+
+func TestMuseDNSRecorderCloseRemovesHook(t *testing.T) {
+	recorder := newMuseDNSRecorder(3)
+	recorder.subscribe()
+	require.NotNil(t, dns.LoadMuseQueryHook())
+	recorder.close()
+	require.Nil(t, dns.LoadMuseQueryHook())
+	require.Equal(t, 0, recorder.subscriberCount())
+}
+
+func TestMuseDNSWebsocket(t *testing.T) {
+	dns.SetMuseQueryHook(nil)
+	recorder := newMuseDNSRecorder(10)
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	server := httptest.NewServer(dnsRouter(nil, ctx, recorder))
+	defer server.Close()
+
+	// seed the buffer through an earlier subscription
+	seed, _ := recorder.subscribe()
+	recorder.record(museQuery("old.example"))
+	recorder.unsubscribe(seed)
+
+	conn, br, _, err := ws.Dial(context.Background(), "ws"+strings.TrimPrefix(server.URL, "http")+"/queries")
+	require.NoError(t, err)
+	var reader io.Reader = conn
+	if br != nil { // frames sent right after the handshake may already be buffered
+		reader = br
+	}
+	rw := struct {
+		io.Reader
+		io.Writer
+	}{reader, conn}
+	read := func() []MuseDNSQuery {
+		_ = conn.SetReadDeadline(time.Now().Add(3 * time.Second))
+		data, _, readErr := wsutil.ReadServerData(rw)
+		require.NoError(t, readErr)
+		var items []MuseDNSQuery
+		require.NoError(t, json.Unmarshal(data, &items))
+		return items
+	}
+	initial := read()
+	require.Len(t, initial, 1)
+	require.Equal(t, "old.example", initial[0].Domain)
+	require.Equal(t, []string{"1.2.3.4"}, initial[0].Answers)
+	require.Equal(t, "223.5.5.5", initial[0].Address)
+
+	require.Eventually(t, func() bool { return dns.LoadMuseQueryHook() != nil }, 2*time.Second, 10*time.Millisecond)
+	museRecordViaHook("live.example")
+	live := read()
+	require.Len(t, live, 1)
+	require.Equal(t, "live.example", live[0].Domain)
+
+	// plain GET = snapshot, DELETE clears
+	response, err := http.Get(server.URL + "/queries")
+	require.NoError(t, err)
+	var snapshot []MuseDNSQuery
+	require.NoError(t, json.NewDecoder(response.Body).Decode(&snapshot))
+	response.Body.Close()
+	require.Len(t, snapshot, 2)
+	request, _ := http.NewRequest(http.MethodDelete, server.URL+"/queries", nil)
+	response, err = http.DefaultClient.Do(request)
+	require.NoError(t, err)
+	response.Body.Close()
+	require.Equal(t, http.StatusNoContent, response.StatusCode)
+	require.Empty(t, recorder.snapshot())
+
+	// client goes away -> subscription and hook end
+	conn.Close()
+	require.Eventually(t, func() bool { return recorder.subscriberCount() == 0 && dns.LoadMuseQueryHook() == nil }, 3*time.Second, 10*time.Millisecond)
+}
