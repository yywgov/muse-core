diff --git a/dns/muse_query.go b/dns/muse_query.go
new file mode 100644
index 000000000..810826c21
--- /dev/null
+++ b/dns/muse_query.go
@@ -0,0 +1,212 @@
+package dns
+
+// 穿云 core: DNS query records for the app's DNS view.
+//
+// The client reports every answer it hands out (network exchange, cache hit or
+// failure) to one process-wide hook. The hook is nil unless the local API has a
+// subscriber, so with nobody watching the only cost is one atomic load per query.
+
+import (
+	"context"
+	"net/netip"
+	"strconv"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing/service"
+
+	"github.com/miekg/dns"
+)
+
+// MuseQuery is one DNS answer handed out by the client.
+type MuseQuery struct {
+	Time       time.Time
+	Domain     string
+	Type       string
+	Server     string // tag of the server that answered (a group member when a group was used)
+	ServerType string // udp, tcp, tls, https, quic, fakeip, local, hosts, ...
+	Address    string // server address as configured, empty for local/fakeip/hosts
+	Group      string // group tag when Server is a member of a group
+	Answers    []string
+	Rcode      string
+	Duration   time.Duration
+	Cached     bool
+	Optimistic bool
+	Error      string
+}
+
+// MuseQueryHook receives finished queries. It must not block.
+type MuseQueryHook func(query *MuseQuery)
+
+var museQueryHook atomic.Pointer[MuseQueryHook]
+
+// SetMuseQueryHook installs hook (nil removes it).
+func SetMuseQueryHook(hook MuseQueryHook) {
+	if hook == nil {
+		museQueryHook.Store(nil)
+		return
+	}
+	museQueryHook.Store(&hook)
+}
+
+// ClearMuseQueryHook removes hook only if it is still the installed one.
+func ClearMuseQueryHook(current *MuseQueryHook) bool {
+	return museQueryHook.CompareAndSwap(current, nil)
+}
+
+// LoadMuseQueryHook returns the installed hook pointer (for ClearMuseQueryHook).
+func LoadMuseQueryHook() *MuseQueryHook {
+	return museQueryHook.Load()
+}
+
+func museQueryActive() bool {
+	return museQueryHook.Load() != nil
+}
+
+type museTraceKey struct{}
+
+type museTrace struct {
+	start  time.Time
+	access sync.Mutex
+	member string
+}
+
+func museWithTrace(ctx context.Context, start time.Time) context.Context {
+	return context.WithValue(ctx, museTraceKey{}, &museTrace{start: start})
+}
+
+func museTraceFrom(ctx context.Context) *museTrace {
+	if ctx == nil {
+		return nil
+	}
+	trace, _ := ctx.Value(museTraceKey{}).(*museTrace)
+	return trace
+}
+
+// MuseNoteServer lets a group transport say which member answered.
+func MuseNoteServer(ctx context.Context, tag string) {
+	trace := museTraceFrom(ctx)
+	if trace == nil {
+		return
+	}
+	trace.access.Lock()
+	trace.member = tag
+	trace.access.Unlock()
+}
+
+// MuseServerAddress is implemented by transports built from remote server options.
+type MuseServerAddress interface {
+	MuseServerAddress() string
+}
+
+func (a *TransportAdapter) MuseServerAddress() string {
+	return a.museAddress
+}
+
+func museFormatAddress(server string, port uint16, transportType string) string {
+	if server == "" {
+		return ""
+	}
+	host := server
+	if addr, err := netip.ParseAddr(server); err == nil && addr.Is6() {
+		host = "[" + server + "]"
+	}
+	defaultPort := uint16(53)
+	switch transportType {
+	case "tls", "quic":
+		defaultPort = 853
+	case "https", "h3":
+		defaultPort = 443
+	}
+	if port != 0 && port != defaultPort {
+		host += ":" + strconv.Itoa(int(port))
+	}
+	if transportType == "" || transportType == "udp" {
+		return host
+	}
+	return transportType + "://" + host
+}
+
+func (c *Client) museDescribe(query *MuseQuery, transport adapter.DNSTransport, trace *museTrace) {
+	if transport == nil {
+		return
+	}
+	query.Server = transport.Tag()
+	query.ServerType = transport.Type()
+	if trace != nil {
+		trace.access.Lock()
+		member := trace.member
+		trace.access.Unlock()
+		if member != "" && member != query.Server {
+			query.Group = query.Server
+			query.Server = member
+			query.ServerType = ""
+			if c.ctx != nil {
+				if manager := service.FromContext[adapter.DNSTransportManager](c.ctx); manager != nil {
+					if memberTransport, loaded := manager.Transport(member); loaded {
+						transport = memberTransport
+						query.ServerType = memberTransport.Type()
+					}
+				}
+			}
+		}
+	}
+	if addresser, ok := transport.(MuseServerAddress); ok {
+		query.Address = addresser.MuseServerAddress()
+	}
+}
+
+func museAnswers(response *dns.Msg) []string {
+	if response == nil {
+		return nil
+	}
+	var answers []string
+	for _, record := range response.Answer {
+		switch rr := record.(type) {
+		case *dns.A:
+			if addr, ok := netip.AddrFromSlice(rr.A); ok {
+				answers = append(answers, addr.Unmap().String())
+			}
+		case *dns.AAAA:
+			if addr, ok := netip.AddrFromSlice(rr.AAAA); ok {
+				answers = append(answers, addr.String())
+			}
+		}
+	}
+	return answers
+}
+
+// museRecord reports one finished query. start is zero when recording was off
+// when the query began; such queries are skipped so a half-timed record never appears.
+func (c *Client) museRecord(ctx context.Context, start time.Time, transport adapter.DNSTransport, question dns.Question, response *dns.Msg, cached bool, optimistic bool, err error) {
+	hook := museQueryHook.Load()
+	if hook == nil || start.IsZero() {
+		return
+	}
+	query := &MuseQuery{
+		Time:       start,
+		Domain:     FqdnToDomain(question.Name),
+		Type:       dns.Type(question.Qtype).String(),
+		Duration:   time.Since(start),
+		Cached:     cached,
+		Optimistic: optimistic,
+	}
+	c.museDescribe(query, transport, museTraceFrom(ctx))
+	if response != nil {
+		query.Rcode = dns.RcodeToString[response.Rcode]
+		query.Answers = museAnswers(response)
+	}
+	if err != nil {
+		query.Error = err.Error()
+	}
+	(*hook)(query)
+}
+
+func museStart() time.Time {
+	if museQueryActive() {
+		return time.Now()
+	}
+	return time.Time{}
+}
