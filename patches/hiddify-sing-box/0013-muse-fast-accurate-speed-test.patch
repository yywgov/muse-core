+package urltest
+
+// muse (穿云 1.10.4): faster and steadier 测速 with one connection per node.
+//
+// The thorough test used to open a warm-up connection and then three more at once, each doing a
+// full connect + TLS + two HEAD requests, and kept the median of the second requests. Now one
+// connection is opened (connect, TLS, the first HEAD — the "setup") and the following HEAD
+// requests are sent on that same kept-alive connection; each of their round trips is a sample.
+// A reused connection has no handshake in it, so the samples are the node's real round trip
+// (the same thing the unified delay measured before), with a quarter of the connections and
+// about half the time. When the server does not keep the connection alive, one new connection is
+// opened for the samples; when no sample can be taken at all the setup time is used (a node that
+// answered is never reported as timed out because a second request failed).
+
+import (
+	"context"
+	"crypto/tls"
+	"errors"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptrace"
+	"net/url"
+	"sync/atomic"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+	"github.com/sagernet/sing/common/ntp"
+)
+
+// MuseSampleOptions describes one sampled test.
+type MuseSampleOptions struct {
+	// SetupTimeout bounds connect + handshakes + the first request.
+	SetupTimeout time.Duration
+	// SampleTimeout bounds each following request.
+	SampleTimeout time.Duration
+	// Samples is how many round trips to take on the kept-alive connection (at least 1).
+	Samples int
+	// OnSetup is called once the first request answered.
+	OnSetup func(setup uint16)
+	// OnFirst is called with the first sample when more are going to follow (shown at once,
+	// refined by the rest).
+	OnFirst func(sample uint16)
+}
+
+// MuseSamples is the outcome of a sampled test.
+type MuseSamples struct {
+	Setup   uint16   // ms from dialing to the first answer
+	Samples []uint16 // round trips on the reused connection (or [Setup], see above)
+	Reused  int      // how many of Samples were taken on a reused connection
+}
+
+const museMaxDials = 2
+
+var errMuseNoMoreDials = errors.New("urltest: connection not kept alive")
+
+// MuseURLTestSamples runs a sampled test of [link] through [detour].
+func MuseURLTestSamples(parent context.Context, link string, detour N.Dialer, opt MuseSampleOptions) (MuseSamples, error) {
+	var out MuseSamples
+	if detour == nil {
+		return out, errors.New("urltest dialer is nil")
+	}
+	if link == "" {
+		link = "https://www.gstatic.com/generate_204"
+	}
+	linkURL, err := url.Parse(link)
+	if err != nil {
+		return out, err
+	}
+	hostname, port := linkURL.Hostname(), linkURL.Port()
+	if port == "" {
+		switch linkURL.Scheme {
+		case "http":
+			port = "80"
+		case "https":
+			port = "443"
+		}
+	}
+	if opt.Samples < 1 {
+		opt.Samples = 1
+	}
+	var dials atomic.Int32
+	// the connection lives as long as this test, not as long as the request that opened it (some
+	// outbounds tie a stream to the dial context); the request contexts bound each step
+	connCtx, cancelConn := context.WithCancel(parent)
+	defer cancelConn()
+	transport := &http.Transport{
+		DialContext: func(_ context.Context, network, addr string) (net.Conn, error) {
+			if dials.Add(1) > museMaxDials {
+				return nil, errMuseNoMoreDials
+			}
+			return detour.DialContext(connCtx, "tcp", M.ParseSocksaddrHostPortStr(hostname, port))
+		},
+		TLSClientConfig: &tls.Config{
+			Time:    ntp.TimeFuncFromContext(parent),
+			RootCAs: adapter.RootPoolFromContext(parent),
+		},
+		MaxIdleConns:        1,
+		MaxIdleConnsPerHost: 1,
+		IdleConnTimeout:     30 * time.Second,
+		ForceAttemptHTTP2:   false,
+	}
+	client := http.Client{
+		Transport: transport,
+		CheckRedirect: func(req *http.Request, via []*http.Request) error {
+			return http.ErrUseLastResponse
+		},
+	}
+	defer client.CloseIdleConnections()
+
+	do := func(timeout time.Duration) (ms uint16, reused bool, err error) {
+		ctx, cancel := context.WithTimeout(parent, timeout)
+		defer cancel()
+		trace := &httptrace.ClientTrace{GotConn: func(info httptrace.GotConnInfo) { reused = info.Reused }}
+		req, err := http.NewRequestWithContext(httptrace.WithClientTrace(ctx, trace), http.MethodHead, link, nil)
+		if err != nil {
+			return 0, false, err
+		}
+		start := time.Now()
+		resp, err := client.Do(req)
+		if err != nil {
+			if ctx.Err() != nil && parent.Err() == nil {
+				return 0, reused, context.DeadlineExceeded
+			}
+			return 0, reused, err
+		}
+		_, _ = io.Copy(io.Discard, io.LimitReader(resp.Body, 4096))
+		resp.Body.Close()
+		d := time.Since(start) / time.Millisecond
+		if d < 1 {
+			d = 1
+		}
+		if d >= time.Duration(65535) {
+			d = 65534
+		}
+		return uint16(d), reused, nil
+	}
+
+	setup, _, err := do(opt.SetupTimeout)
+	if err != nil {
+		return out, err
+	}
+	out.Setup = setup
+	if opt.OnSetup != nil {
+		opt.OnSetup(setup)
+	}
+	if !IsUnifiedDelayFromContext(parent) {
+		// the plain delay is the whole first request, as urlTest reports it
+		out.Samples = []uint16{setup}
+		return out, nil
+	}
+	sampleTimeout := opt.SampleTimeout
+	if sampleTimeout <= 0 {
+		sampleTimeout = opt.SetupTimeout
+	}
+	// one extra try: a request that had to open a new connection is setup, not a sample
+	for tries := 0; len(out.Samples) < opt.Samples && tries < opt.Samples+1; tries++ {
+		if parent.Err() != nil {
+			break
+		}
+		d, reused, err := do(sampleTimeout)
+		if err != nil {
+			break
+		}
+		if !reused {
+			continue
+		}
+		out.Samples = append(out.Samples, d)
+		out.Reused++
+		if len(out.Samples) == 1 && opt.Samples > 1 && opt.OnFirst != nil {
+			opt.OnFirst(d)
+		}
+	}
+	if len(out.Samples) == 0 {
+		// the node answered; without a reused round trip its setup time is the best we have
+		out.Samples = []uint16{setup}
+	}
+	return out, nil
+}
diff --git a/common/urltest/muse_samples_test.go b/common/urltest/muse_samples_test.go
new file mode 100644
index 000000000..8c1133951
--- /dev/null
+++ b/common/urltest/muse_samples_test.go
@@ -0,0 +1,117 @@
+package urltest
+
+import (
+	"context"
+	"errors"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	M "github.com/sagernet/sing/common/metadata"
+
+	"github.com/stretchr/testify/require"
+)
+
+// slowConn adds [rtt] to every request it carries (one round trip per write).
+type slowConn struct {
+	net.Conn
+	rtt time.Duration
+}
+
+func (c *slowConn) Write(b []byte) (int, error) { time.Sleep(c.rtt); return c.Conn.Write(b) }
+
+type rttDialer struct {
+	addr      string
+	handshake time.Duration
+	rtt       time.Duration
+	dials     atomic.Int32
+	fail      error
+}
+
+func (d *rttDialer) DialContext(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
+	d.dials.Add(1)
+	if d.fail != nil {
+		return nil, d.fail
+	}
+	select {
+	case <-time.After(d.handshake):
+	case <-ctx.Done():
+		return nil, ctx.Err()
+	}
+	var dialer net.Dialer
+	conn, err := dialer.DialContext(ctx, network, d.addr)
+	if err != nil {
+		return nil, err
+	}
+	return &slowConn{Conn: conn, rtt: d.rtt}, nil
+}
+
+func (d *rttDialer) ListenPacket(ctx context.Context, destination M.Socksaddr) (net.PacketConn, error) {
+	return nil, net.ErrClosed
+}
+
+// 穿云 1.10.4: one connection, HEAD requests kept alive; the samples are the round trips on the
+// reused connection (no handshake in them), the first is reported early.
+func TestMuseURLTestSamplesReuseOneConnection(t *testing.T) {
+	server, hits := countingServer(t) // asserts HEAD
+	d := &rttDialer{addr: server.Listener.Addr().String(), handshake: 150 * time.Millisecond, rtt: 40 * time.Millisecond}
+	ctx := ContextWithIsUnifiedDelay(context.Background())
+	var first, setupSeen atomic.Int32
+	r, err := MuseURLTestSamples(ctx, server.URL+"/generate_204", d, MuseSampleOptions{
+		SetupTimeout: 2 * time.Second, SampleTimeout: time.Second, Samples: 3,
+		OnSetup: func(uint16) { setupSeen.Add(1) },
+		OnFirst: func(s uint16) { first.Store(int32(s)) },
+	})
+	require.NoError(t, err)
+	require.Equal(t, int32(1), d.dials.Load(), "one connection per test")
+	require.Equal(t, int32(4), hits.Load(), "setup + 3 samples")
+	require.Len(t, r.Samples, 3)
+	require.Equal(t, 3, r.Reused)
+	require.Equal(t, int32(1), setupSeen.Load())
+	require.NotZero(t, first.Load())
+	require.GreaterOrEqual(t, r.Setup, uint16(190), "setup includes the handshake")
+	for _, s := range r.Samples {
+		require.GreaterOrEqual(t, s, uint16(40))
+		require.Less(t, s, uint16(140), "a sample is a round trip, not a handshake")
+	}
+}
+
+func TestMuseURLTestSamplesPlainDelayIsSetup(t *testing.T) {
+	server, hits := countingServer(t)
+	d := &rttDialer{addr: server.Listener.Addr().String(), handshake: 50 * time.Millisecond}
+	r, err := MuseURLTestSamples(context.Background(), server.URL, d, MuseSampleOptions{SetupTimeout: time.Second, Samples: 3})
+	require.NoError(t, err)
+	require.Equal(t, []uint16{r.Setup}, r.Samples)
+	require.Equal(t, int32(1), hits.Load())
+}
+
+// A server that closes every connection: the node still answered, so it is never a failure.
+func TestMuseURLTestSamplesNoKeepAlive(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Connection", "close")
+		w.WriteHeader(http.StatusNoContent)
+	}))
+	defer server.Close()
+	d := &rttDialer{addr: server.Listener.Addr().String()}
+	r, err := MuseURLTestSamples(ContextWithIsUnifiedDelay(context.Background()), server.URL, d, MuseSampleOptions{SetupTimeout: time.Second, Samples: 3})
+	require.NoError(t, err)
+	require.NotEmpty(t, r.Samples)
+	require.LessOrEqual(t, d.dials.Load(), int32(museMaxDials), "at most one new connection for the samples")
+}
+
+func TestMuseURLTestSamplesSetupTimeoutAndRefused(t *testing.T) {
+	server, _ := countingServer(t)
+	d := &rttDialer{addr: server.Listener.Addr().String(), handshake: 2 * time.Second}
+	start := time.Now()
+	_, err := MuseURLTestSamples(context.Background(), server.URL, d, MuseSampleOptions{SetupTimeout: 200 * time.Millisecond, Samples: 3})
+	require.Error(t, err)
+	require.ErrorIs(t, err, context.DeadlineExceeded)
+	require.Less(t, time.Since(start), time.Second, "the setup timeout bounds the test")
+
+	refused := &rttDialer{fail: errors.New("dial tcp 1.2.3.4:443: connect: connection refused")}
+	_, err = MuseURLTestSamples(context.Background(), server.URL, refused, MuseSampleOptions{SetupTimeout: time.Second, Samples: 3})
+	require.ErrorContains(t, err, "connection refused")
+}
