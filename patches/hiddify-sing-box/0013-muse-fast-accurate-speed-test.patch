+// museRace runs [try] [n] times and returns the first success. With [hedge] > 0 the tries start
+// one after another, each [hedge] after the previous one unless that one already got its first
+// answer (answered); with 0 they all start at once. The others are cancelled. When all fail the
+// error of one that did not fail fast is returned (so a mix still counts as a timeout).
+//
+// [tokens] caps the test connections open at once across the monitor: the first try waits for a
+// token, the extra ones only start when a token is free (nil = no cap).
+func museRace(parent context.Context, tokens chan struct{}, n int, hedge time.Duration, try func(ctx context.Context, answered func()) ([]uint16, error)) ([]uint16, error) {
+	ctx, cancel := context.WithCancel(parent)
+	defer cancel()
+	if tokens != nil {
+		select {
+		case tokens <- struct{}{}:
+		case <-parent.Done():
+			return nil, parent.Err()
+		}
+	}
+	type result struct {
+		samples []uint16
+		err     error
+	}
+	results := make(chan result, n)
+	answered := make(chan struct{})
+	var answerOnce sync.Once
+	mark := func() { answerOnce.Do(func() { close(answered) }) }
+	launch := func() {
+		go func() {
+			if tokens != nil {
+				defer func() { <-tokens }()
+			}
+			s, err := try(ctx, mark)
+			results <- result{s, err}
+		}()
+	}
+	// an extra try only with a free token
+	extra := func() bool {
+		if tokens != nil {
+			select {
+			case tokens <- struct{}{}:
+			default:
+				return false
+			}
+		}
+		launch()
+		return true
+	}
+	started := 1
+	launch()
+	if hedge <= 0 {
+		for started < n && extra() {
+			started++
+		}
+	}
+	var timer <-chan time.Time
+	if hedge > 0 && started < n {
+		timer = time.After(hedge)
+	}
+	var lastErr, slowErr error
+	for got := 0; got < started; {
+		select {
+		case r := <-results:
+			got++
+			if r.err == nil && len(r.samples) > 0 {
+				return r.samples, nil
+			}
+			lastErr = r.err
+			if r.err != nil && !museFastFailure(r.err) {
+				slowErr = r.err
+			}
+			if hedge > 0 && got == started && started < n && museFastFailure(r.err) {
+				// refused at once: another connection will not change that
+				return nil, r.err
+			}
+		case <-timer:
+			timer = nil
+			select {
+			case <-answered:
+			default:
+				if extra() {
+					started++
+				}
+				if started < n {
+					timer = time.After(hedge)
+				}
+			}
+		case <-parent.Done():
+			return nil, parent.Err()
+		}
+	}
+	if slowErr != nil {
+		return nil, slowErr
+	}
+	if lastErr == nil {
+		lastErr = errors.New("timeout")
+	}
+	return nil, lastErr
+}
