new file mode 100644
index 000000000..181cc36fd
--- /dev/null
+++ b/common/monitoring/muse_speedtest_sim_test.go
@@ -0,0 +1,383 @@
+package monitoring
+
+// 穿云 1.10.4: a simulation of one 测速 over 50 / 100 / 200 nodes on a congested home line, with
+// the 1.10.3 strategy and the 1.10.4 one (both modelled from their code, same random nodes and
+// line). It shows that the whole test is faster and that working nodes are not reported 超时
+// more often.
+//
+// Line model: every connection has a base time from the node's round trip (connect + TLS = 3 RTT
+// through the proxy, each HTTP request 1 RTT). Each packet exchange of a connection can be lost
+// with probability q, which grows once more connections are open at once than the line takes
+// (24, the 1.10.3 budget; China Mobile style session limit / QoS); a loss costs the TCP
+// retransmission (1 s, then 2 s, 4 s …). Node mix: working nodes (80–400 ms), slow ones
+// (0.9–1.8 s), nodes that never answer, refused ones, and working nodes on a lossy route.
+
+import (
+	"math"
+	"math/rand"
+	"sort"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+type simNodeKind int
+
+const (
+	simGood simNodeKind = iota
+	simSlow
+	simDead
+	simRefused
+	simLossy
+)
+
+type simNode struct {
+	kind simNodeKind
+	rtt  float64 // seconds
+}
+
+type simLine struct {
+	rng   *rand.Rand
+	limit int
+}
+
+// q: chance that one packet exchange is lost with [open] connections at once.
+func (l *simLine) q(open int, lossy bool) float64 {
+	q := 0.02
+	if lossy {
+		q = 0.15
+	}
+	if open > l.limit {
+		q += 0.6 * float64(open-l.limit) / float64(l.limit)
+	}
+	return math.Min(q, 0.9)
+}
+
+// penalty: retransmission time of [exchanges] packet exchanges (geometric losses each).
+func (l *simLine) penalty(exchanges int, q float64) float64 {
+	p := 0.0
+	for i := 0; i < exchanges; i++ {
+		rto := 1.0
+		for l.rng.Float64() < q && rto < 64 {
+			p += rto
+			rto *= 2
+		}
+	}
+	return p
+}
+
+// conn returns when the setup (connect + TLS + first request) and the following [req] requests
+// on the same connection finish (math.Inf = never) and the measured round trip of those requests.
+func (l *simLine) conn(n simNode, open int, req int) (setup, done float64, sample float64) {
+	switch n.kind {
+	case simDead:
+		return math.Inf(1), math.Inf(1), 0
+	case simRefused:
+		return -0.05, -0.05, 0 // negative = failed fast after |t|
+	}
+	q := l.q(open, n.kind == simLossy)
+	jitter := func() float64 { return n.rtt * (1 + 0.15*l.rng.NormFloat64()*0.5) }
+	setup = 3*n.rtt + jitter() + l.penalty(4, q)
+	done = setup
+	var samples []float64
+	for i := 0; i < req; i++ {
+		s := jitter() + l.penalty(1, q)
+		samples = append(samples, s)
+		done += s
+	}
+	if len(samples) > 0 {
+		sort.Float64s(samples)
+		sample = samples[len(samples)/2]
+	}
+	return setup, done, sample
+}
+
+type simJob struct {
+	node     int
+	retest   bool
+	ready    float64
+	priority bool
+}
+
+type simRun struct {
+	end   float64
+	conns int
+	node  int
+	ok    bool
+	fast  bool
+	value float64
+	job   simJob
+}
+
+type simResult struct {
+	total       float64 // until every node has its final result
+	falseTO     int     // working nodes (good / slow / lossy) reported as timed out
+	shownErrMs  float64 // mean |shown − true RTT| of working nodes, ms
+	peakConns   int
+	firstShownS float64 // mean time until a working node shows a number
+}
+
+// attempt of one strategy: duration, connections, success, fast failure, value.
+type simAttempt func(l *simLine, n simNode, open int, retest bool) (dur float64, conns int, ok, fast bool, value float64)
+
+// 1.10.3: warm-up connection (8 s) then 3 connections at once (short timeout), each doing two
+// requests; the median of the second requests. A failed node is tested again (same test) 3 s
+// later, behind the queue.
+func simOld(l *simLine, n simNode, open int, retest bool) (float64, int, bool, bool, float64) {
+	const full = 8.0
+	ws, wd, _ := l.conn(n, open+1, 1)
+	warmOK := ws >= 0 && wd <= full
+	var dur float64
+	sampleTimeout := 3.0
+	switch {
+	case ws < 0:
+		dur = -ws
+	case warmOK:
+		dur = wd
+		sampleTimeout = math.Min(math.Max(3, wd*4+1.5), full) // museProbeTimeout(warm)
+	default:
+		dur = full
+	}
+	var vals []float64
+	longest := 0.0
+	for i := 0; i < 3; i++ {
+		s, d, v := l.conn(n, open+3, 1)
+		if s < 0 {
+			longest = math.Max(longest, -s)
+			continue
+		}
+		if d <= sampleTimeout {
+			vals = append(vals, v)
+			longest = math.Max(longest, d)
+		} else {
+			longest = sampleTimeout
+		}
+	}
+	dur += longest
+	if len(vals) == 0 {
+		return dur, 3, false, false, 0
+	}
+	sort.Float64s(vals)
+	return dur, 3, true, false, vals[len(vals)/2]
+}
+
+// 1.10.4: one connection, 5 s setup (second connection after 2.5 s if no answer yet), three
+// round trips on it; refused = final; a timeout is re-tested 1 s later ahead of the queue with
+// three connections at once and the full 8 s.
+func simNew(l *simLine, n simNode, open int, retest bool) (float64, int, bool, bool, float64) {
+	const full, tier, hedge = 8.0, 5.0, 2.5
+	budget := museConnBudget(8)
+	if retest {
+		best := math.Inf(1)
+		var value float64
+		tries := min(museRetestParallel, max(1, budget-open)) // extra tries only within the budget
+		for i := 0; i < tries; i++ {
+			s, d, v := l.conn(n, open+tries, 1)
+			if s >= 0 && s <= full && d < best {
+				best, value = d, v
+			}
+		}
+		if math.IsInf(best, 1) {
+			return full, tries, false, false, 0
+		}
+		return best, tries, true, false, value
+	}
+	s, d, v := l.conn(n, open+1, museSamplesFast)
+	if s < 0 {
+		return -s, 1, false, true, 0
+	}
+	conns := 1
+	if s > hedge && open+2 <= budget {
+		conns = 2
+		s2, d2, v2 := l.conn(n, open+2, museSamplesFast)
+		if s2 >= 0 && hedge+s2 < s {
+			s, d, v = hedge+s2, hedge+d2, v2
+		}
+	}
+	if s > tier {
+		return tier, conns, false, false, 0
+	}
+	return d, conns, true, false, v
+}
+
+func simulate(seed int64, nodes []simNode, attempt simAttempt, adaptive bool) simResult {
+	l := &simLine{rng: rand.New(rand.NewSource(seed)), limit: 24}
+	var res simResult
+	var queue []simJob
+	for i := range nodes {
+		queue = append(queue, simJob{node: i, priority: true})
+	}
+	gate := newMuseGate(8)
+	limit := func() int {
+		if adaptive {
+			return gate.limit
+		}
+		return 8
+	}
+	var running []simRun
+	now := 0.0
+	final := 0
+	shownAt := make([]float64, len(nodes))
+	var errSum float64
+	var errN int
+	retestDelay, retestPriority := 3.0, false
+	if adaptive {
+		retestDelay, retestPriority = museRetestBackoff.Seconds(), true
+	}
+	for final < len(nodes) {
+		// start what can start
+		for len(running) < limit() {
+			pick := -1
+			for i, j := range queue { // priority first, FIFO
+				if j.ready <= now && j.priority {
+					pick = i
+					break
+				}
+			}
+			if pick < 0 {
+				for i, j := range queue {
+					if j.ready <= now {
+						pick = i
+						break
+					}
+				}
+			}
+			if pick < 0 {
+				break
+			}
+			j := queue[pick]
+			queue = append(queue[:pick], queue[pick+1:]...)
+			open := 0
+			for _, r := range running {
+				open += r.conns
+			}
+			if adaptive && open >= museConnBudget(8) {
+				queue = append(queue[:pick], append([]simJob{j}, queue[pick:]...)...) // waits for a token
+				break
+			}
+			dur, conns, ok, fast, value := attempt(l, nodes[j.node], open, j.retest)
+			running = append(running, simRun{end: now + dur, conns: conns, node: j.node, ok: ok, fast: fast, value: value, job: j})
+			if open+conns > res.peakConns {
+				res.peakConns = open + conns
+			}
+		}
+		// next event
+		next := math.Inf(1)
+		for _, r := range running {
+			next = math.Min(next, r.end)
+		}
+		for _, j := range queue {
+			if j.ready > now {
+				next = math.Min(next, j.ready)
+			}
+		}
+		now = next
+		kept := running[:0]
+		for _, r := range running {
+			if r.end > now {
+				kept = append(kept, r)
+				continue
+			}
+			kind := museResultOK
+			switch {
+			case r.fast:
+				kind = museResultFast
+			case !r.ok:
+				kind = museResultSlow
+			}
+			if adaptive {
+				gate.observe(kind)
+			}
+			n := nodes[r.node]
+			working := n.kind == simGood || n.kind == simSlow || n.kind == simLossy
+			switch {
+			case r.ok:
+				final++
+				if working {
+					shownAt[r.node] = now
+				}
+				if n.kind == simGood { // accuracy on the nodes both strategies measure
+					errSum += math.Abs(r.value-n.rtt) * 1000
+					errN++
+				}
+			case r.job.retest || (adaptive && r.fast):
+				final++
+				if working {
+					res.falseTO++
+				}
+			default:
+				queue = append(queue, simJob{node: r.node, retest: true, ready: now + retestDelay, priority: retestPriority})
+			}
+		}
+		running = kept
+	}
+	res.total = now
+	if errN > 0 {
+		res.shownErrMs = errSum / float64(errN)
+	}
+	sum, cnt := 0.0, 0
+	for _, t := range shownAt {
+		if t > 0 {
+			sum += t
+			cnt++
+		}
+	}
+	if cnt > 0 {
+		res.firstShownS = sum / float64(cnt)
+	}
+	return res
+}
+
+func simNodes(seed int64, count int) []simNode {
+	rng := rand.New(rand.NewSource(seed * 7919))
+	nodes := make([]simNode, count)
+	for i := range nodes {
+		p := rng.Float64()
+		switch {
+		case p < 0.60:
+			nodes[i] = simNode{simGood, 0.08 + rng.Float64()*0.32}
+		case p < 0.70:
+			nodes[i] = simNode{simSlow, 0.9 + rng.Float64()*0.9}
+		case p < 0.82:
+			nodes[i] = simNode{simDead, 0}
+		case p < 0.92:
+			nodes[i] = simNode{simRefused, 0}
+		default:
+			nodes[i] = simNode{simLossy, 0.1 + rng.Float64()*0.3}
+		}
+	}
+	return nodes
+}
+
+func TestMuseSpeedTestSimulation(t *testing.T) {
+	const seeds = 40
+	for _, count := range []int{50, 100, 200} {
+		var old, cur simResult
+		for seed := int64(1); seed <= seeds; seed++ {
+			nodes := simNodes(seed, count)
+			o := simulate(seed, nodes, simOld, false)
+			c := simulate(seed, nodes, simNew, true)
+			old.total += o.total / seeds
+			cur.total += c.total / seeds
+			old.falseTO += o.falseTO
+			cur.falseTO += c.falseTO
+			old.shownErrMs += o.shownErrMs / seeds
+			cur.shownErrMs += c.shownErrMs / seeds
+			old.firstShownS += o.firstShownS / seeds
+			cur.firstShownS += c.firstShownS / seeds
+			old.peakConns = max(old.peakConns, o.peakConns)
+			cur.peakConns = max(cur.peakConns, c.peakConns)
+		}
+		t.Logf("N=%d  total 1.10.3 %.1f s → 1.10.4 %.1f s (−%.0f%%) | working node shown after %.1f s → %.1f s | false 超时 (in %d runs) %d → %d | shown error %.0f → %.0f ms | peak connections %d → %d",
+			count, old.total, cur.total, 100*(1-cur.total/old.total), old.firstShownS, cur.firstShownS,
+			seeds, old.falseTO, cur.falseTO, old.shownErrMs, cur.shownErrMs, old.peakConns, cur.peakConns)
+		require.Less(t, cur.total, old.total*0.7, "N=%d: at least 30%% faster", count)
+		require.LessOrEqual(t, cur.falseTO, old.falseTO, "N=%d: no more false 超时", count)
+		require.Less(t, cur.firstShownS, old.firstShownS, "N=%d: numbers show sooner", count)
+		require.LessOrEqual(t, cur.shownErrMs, old.shownErrMs*1.15, "N=%d: values as close to the real round trip", count)
+		require.LessOrEqual(t, cur.peakConns, 24, "N=%d: never more connections at once than 1.10.3", count)
+	}
+}
+
+var _ = time.Second
