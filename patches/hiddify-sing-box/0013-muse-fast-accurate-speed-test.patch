diff --git a/common/monitoring/muse_fast.go b/common/monitoring/muse_fast.go
new file mode 100644
index 000000000..e3e28ce9f
--- /dev/null
+++ b/common/monitoring/muse_fast.go
@@ -0,0 +1,292 @@
+package monitoring
+
+// muse (穿云 1.10.4): 测速 faster and more accurate without bringing back the false 超时 of
+// congested home lines (1.10.3).
+//
+//   - One connection per node (see urltest.MuseURLTestSamples): setup, then up to three round
+//     trips on the kept-alive connection; the first is shown at once, the others refine it. The
+//     shown value is the median of the reused round trips (no handshake in it).
+//   - Two timeout tiers: the first test of a node gets 5 s (5/8 of the configured timeout); a
+//     connection refused / a server name that does not exist fails at once and is final; only a
+//     real timeout is tested again — 1 s later, ahead of the queue, with the full timeout and
+//     three connections at once — before 超时 is shown. A node is 超时 only after both tiers.
+//   - Adaptive concurrency: starts at the configured count (8) and grows by 4 after each round
+//     without a timeout, up to 3× (24); several timeouts among the last results drop it back to
+//     the configured count. 24 single-connection tests open no more connections at once than
+//     1.10.3's 8 workers × 3 probes.
+//   - Nodes with exactly the same configuration (only the name differs) are tested once and
+//     share the result.
+//   - A result younger than 60 s is reused by automatic tests; a 测速 the user asks for always
+//     tests again.
+
+import (
+	"context"
+	"errors"
+	"net"
+	"strings"
+	"sync"
+	"syscall"
+	"time"
+)
+
+const (
+	museFirstTierMin   = 3 * time.Second
+	museFirstTierMax   = 5 * time.Second
+	museRetestBackoff  = 1 * time.Second
+	museRetestParallel = 3
+	museHedgeAfter     = 2500 * time.Millisecond
+	museFreshFor       = 60 * time.Second
+	museGateCeiling    = 24
+	museGateStep       = 4
+	museGateWindow     = 8
+	museGateSlowToDrop = 3
+	museSamplesFast    = 3 // round trips per thorough test on the reused connection
+)
+
+// museResultKind is what one test attempt came to.
+type museResultKind int
+
+const (
+	museResultOK   museResultKind = iota
+	museResultFast                // failed at once: refused, no such host — final
+	museResultSlow                // no answer in time (or a failure that may pass): tested again
+)
+
+// museFirstTierTimeout: the setup timeout of a node's first test.
+func museFirstTierTimeout(full time.Duration) time.Duration {
+	t := full * 5 / 8
+	if t < museFirstTierMin {
+		t = museFirstTierMin
+	}
+	if t > museFirstTierMax {
+		t = museFirstTierMax
+	}
+	if t > full {
+		t = full
+	}
+	return t
+}
+
+// museSampleTimeout bounds one round trip on the kept-alive connection: half the full timeout,
+// at least museMinProbeTimeout.
+func museSampleTimeout(full time.Duration) time.Duration {
+	t := full / 2
+	if t < museMinProbeTimeout {
+		t = museMinProbeTimeout
+	}
+	if t > full {
+		t = full
+	}
+	return t
+}
+
+// museFastFailure: errors that say the node cannot answer, with no packet loss involved.
+func museFastFailure(err error) bool {
+	if err == nil {
+		return false
+	}
+	if errors.Is(err, context.DeadlineExceeded) || errors.Is(err, context.Canceled) {
+		return false
+	}
+	if errors.Is(err, syscall.ECONNREFUSED) {
+		return true
+	}
+	var dnsErr *net.DNSError
+	if errors.As(err, &dnsErr) && dnsErr.IsNotFound {
+		return true
+	}
+	s := strings.ToLower(err.Error())
+	if strings.Contains(s, "timeout") || strings.Contains(s, "deadline") {
+		return false
+	}
+	return strings.Contains(s, "connection refused") || strings.Contains(s, "no such host") ||
+		strings.Contains(s, "nxdomain")
+}
+
+func museKindOf(err error, delay uint16) museResultKind {
+	switch {
+	case err == nil && delay > 0 && delay < TimeoutDelay:
+		return museResultOK
+	case museFastFailure(err):
+		return museResultFast
+	default:
+		return museResultSlow
+	}
+}
+
+// museGateMax is the most tests at once the gate grows to from [base].
+func museGateMax(base int) int {
+	m := base * 3
+	if m > museGateCeiling {
+		m = museGateCeiling
+	}
+	if m < base {
+		m = base
+	}
+	return m
+}
+
+// museConnBudget: test connections open at once — 1.10.3's 8 workers × 3 probes (24), or the
+// worker count the user picked when that is higher. Extra connections (a hedge, the three tries
+// of a re-test) only start within it.
+func museConnBudget(base int) int {
+	if base > museGateCeiling {
+		return base
+	}
+	return museGateCeiling
+}
+
+// museGate limits how many tests run at once and adapts the limit (AIMD-like: +4 after a round
+// without a timeout, back to base after several timeouts close together).
+type museGate struct {
+	mu      sync.Mutex
+	base    int
+	max     int
+	limit   int
+	inUse   int
+	streak  int
+	recent  []bool // last results, true = timed out
+	wake    chan struct{}
+	peakUse int // for tests
+}
+
+func newMuseGate(base int) *museGate {
+	return &museGate{base: base, max: museGateMax(base), limit: base, wake: make(chan struct{})}
+}
+
+func (g *museGate) acquire(ctx context.Context) bool {
+	for {
+		g.mu.Lock()
+		if g.inUse < g.limit {
+			g.inUse++
+			if g.inUse > g.peakUse {
+				g.peakUse = g.inUse
+			}
+			g.mu.Unlock()
+			return true
+		}
+		wake := g.wake
+		g.mu.Unlock()
+		select {
+		case <-ctx.Done():
+			return false
+		case <-wake:
+		}
+	}
+}
+
+// release frees a slot; [counted] = a test ran and [kind] is how it ended.
+func (g *museGate) release(counted bool, kind museResultKind) {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	g.inUse--
+	if counted {
+		g.observe(kind)
+	}
+	close(g.wake)
+	g.wake = make(chan struct{})
+}
+
+func (g *museGate) observe(kind museResultKind) {
+	slow := kind == museResultSlow
+	g.recent = append(g.recent, slow)
+	if len(g.recent) > museGateWindow {
+		g.recent = g.recent[len(g.recent)-museGateWindow:]
+	}
+	if slow {
+		g.streak = 0
+		n := 0
+		for _, s := range g.recent {
+			if s {
+				n++
+			}
+		}
+		if n >= museGateSlowToDrop && g.limit > g.base {
+			g.limit = g.base
+			g.recent = nil
+		}
+		return
+	}
+	g.streak++
+	if g.streak >= g.limit && g.limit < g.max {
+		g.limit += museGateStep
+		if g.limit > g.max {
+			g.limit = g.max
+		}
+		g.streak = 0
+	}
+}
+
+// reset: a new network starts again from the configured count.
+func (g *museGate) reset() {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	g.limit, g.streak, g.recent = g.base, 0, nil
+}
+
+func (g *museGate) currentLimit() int {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	return g.limit
+}
+
+// museSameAs maps a node to the node with the same configuration that is tested for it.
+type museSameAs struct {
+	primary map[string]string   // duplicate -> primary
+	mirrors map[string][]string // primary -> duplicates
+}
+
+func newMuseSameAs(sameAs map[string]string) *museSameAs {
+	s := &museSameAs{primary: map[string]string{}, mirrors: map[string][]string{}}
+	for dup, p := range sameAs {
+		if dup == "" || p == "" || dup == p {
+			continue
+		}
+		if _, chained := sameAs[p]; chained {
+			continue // a primary is never a duplicate itself
+		}
+		s.primary[dup] = p
+		s.mirrors[p] = append(s.mirrors[p], dup)
+	}
+	return s
+}
+
+func (m *OutboundMonitoring) sameAs() *museSameAs {
+	if s := m.museSame.Load(); s != nil {
+		return s
+	}
+	return &museSameAs{}
+}
+
+// primaryOf is the node tested for [tag].
+func (m *OutboundMonitoring) primaryOf(tag string) string {
+	if p, ok := m.sameAs().primary[tag]; ok && m.getState(p) != nil {
+		return p
+	}
+	return tag
+}
+
+// museFresh: an automatic test of this node can reuse its result.
+func museFresh(state *outboundState, now time.Time) bool {
+	v := state.latency.value
+	return !state.invalid && !state.from_cache && v > 0 && v < TimeoutDelay &&
+		!state.history.Time.IsZero() && now.Sub(state.history.Time) < museFreshFor
+}
+
+// applyInterim shows the first round trip of a thorough test at once (refined by the final result).
+func (m *OutboundMonitoring) applyInterim(tag string, sample uint16) {
+	for _, t := range append([]string{tag}, m.sameAs().mirrors[tag]...) {
+		state := m.getState(t)
+		if state == nil {
+			continue
+		}
+		state.mu.Lock()
+		state.history.Delay = state.latency.preview(sample)
+		state.history.Time = time.Now()
+		state.from_cache = false
+		m.history.StoreURLTestHistory(t, &state.history)
+		groups := state.groupTags
+		state.mu.Unlock()
+		m.emitGroupEvent(groups)
+	}
+}
