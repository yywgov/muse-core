@@ -0,0 +1,394 @@
+package monitoring
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"sync"
+	"sync/atomic"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/urltest"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common/json/badoption"
+	M "github.com/sagernet/sing/common/metadata"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestMuseFirstTierTimeout(t *testing.T) {
+	require.Equal(t, 5*time.Second, museFirstTierTimeout(8*time.Second))
+	require.Equal(t, 5*time.Second, museFirstTierTimeout(10*time.Second))
+	require.Equal(t, 3125*time.Millisecond, museFirstTierTimeout(5*time.Second))
+	require.Equal(t, 2*time.Second, museFirstTierTimeout(2*time.Second), "never longer than the full timeout")
+	require.Equal(t, 4*time.Second, museSampleTimeout(8*time.Second))
+	require.Equal(t, museMinProbeTimeout, museSampleTimeout(4*time.Second))
+}
+
+func TestMuseFastFailure(t *testing.T) {
+	require.True(t, museFastFailure(errors.New("dial tcp 1.2.3.4:443: connect: connection refused")))
+	require.True(t, museFastFailure(fmt.Errorf("wrap: %w", syscall.ECONNREFUSED)))
+	require.True(t, museFastFailure(&net.DNSError{Err: "no such host", Name: "x.invalid", IsNotFound: true}))
+	require.True(t, museFastFailure(errors.New("lookup x.invalid: no such host")))
+	require.False(t, museFastFailure(context.DeadlineExceeded))
+	require.False(t, museFastFailure(errors.New("i/o timeout")))
+	require.False(t, museFastFailure(errors.New("connection reset by peer")), "a reset may be a lossy line: tested again")
+	require.False(t, museFastFailure(errors.New("EOF")))
+	require.False(t, museFastFailure(nil))
+	require.Equal(t, museResultOK, museKindOf(nil, 120))
+	require.Equal(t, museResultSlow, museKindOf(nil, TimeoutDelay))
+	require.Equal(t, museResultFast, museKindOf(errors.New("connection refused"), 0))
+}
+
+// The adaptive gate: +4 after a round without a timeout, up to 24; three timeouts close together
+// drop it to the configured count; a network change starts again from it.
+func TestMuseGateAdapts(t *testing.T) {
+	g := newMuseGate(8)
+	require.Equal(t, 8, g.currentLimit())
+	require.Equal(t, 24, g.max)
+	for i := 0; i < 8; i++ {
+		g.observe(museResultOK)
+	}
+	require.Equal(t, 12, g.currentLimit())
+	for i := 0; i < 12+16+20; i++ {
+		g.observe(museResultOK)
+	}
+	require.Equal(t, 24, g.currentLimit())
+	for i := 0; i < 50; i++ {
+		g.observe(museResultOK)
+	}
+	require.Equal(t, 24, g.currentLimit(), "never above 3× / 24")
+	// refused nodes are not congestion
+	for i := 0; i < 10; i++ {
+		g.observe(museResultFast)
+	}
+	require.Equal(t, 24, g.currentLimit())
+	// one timeout here and there keeps the limit
+	g.observe(museResultSlow)
+	for i := 0; i < 8; i++ {
+		g.observe(museResultOK)
+	}
+	g.observe(museResultSlow)
+	require.Equal(t, 24, g.currentLimit())
+	// timeouts close together: back to 8
+	g.observe(museResultSlow)
+	g.observe(museResultOK)
+	g.observe(museResultSlow)
+	require.Equal(t, 8, g.currentLimit())
+	g.limit = 20
+	g.reset()
+	require.Equal(t, 8, g.currentLimit())
+
+	require.Equal(t, 12, museGateMax(4))
+	require.Equal(t, 24, museGateMax(16))
+	require.Equal(t, 32, museGateMax(32), "a higher count the user picked is kept")
+	require.Equal(t, 32, museConnBudget(32))
+}
+
+func TestMuseGateLimitsConcurrency(t *testing.T) {
+	g := newMuseGate(4)
+	var running, peak atomic.Int32
+	var wg sync.WaitGroup
+	for i := 0; i < 40; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			require.True(t, g.acquire(context.Background()))
+			n := running.Add(1)
+			for {
+				p := peak.Load()
+				if n <= p || peak.CompareAndSwap(p, n) {
+					break
+				}
+			}
+			time.Sleep(2 * time.Millisecond)
+			running.Add(-1)
+			g.release(true, museResultOK)
+		}()
+	}
+	wg.Wait()
+	require.LessOrEqual(t, int(peak.Load()), 12)
+	require.Greater(t, int(peak.Load()), 4, "grew after rounds without a timeout")
+	ctx, cancel := context.WithCancel(context.Background())
+	g2 := newMuseGate(4)
+	for i := 0; i < 4; i++ {
+		require.True(t, g2.acquire(ctx))
+	}
+	cancel()
+	require.False(t, g2.acquire(ctx), "a full gate gives up when the monitor stops")
+}
+
+// 穿云 1.10.4 museLatency.applyKind: refused = final at once; a first-try timeout = 0 + re-test;
+// the re-test decides.
+func TestMuseLatencyApplyKind(t *testing.T) {
+	var l museLatency
+	r, retest := l.applyKind(true, museResultFast, TimeoutDelay, false)
+	require.Equal(t, TimeoutDelay, r, "refused: 超时 at once")
+	require.False(t, retest)
+
+	l = museLatency{}
+	r, retest = l.applyKind(true, museResultSlow, TimeoutDelay, false)
+	require.Equal(t, uint16(0), r, "timed out on the first try: still testing")
+	require.True(t, retest)
+	r, retest = l.applyKind(true, museResultOK, 640, true)
+	require.Equal(t, uint16(640), r, "the slow node answered the re-test")
+	require.False(t, retest)
+
+	l = museLatency{}
+	l.applyKind(true, museResultSlow, TimeoutDelay, false)
+	r, retest = l.applyKind(true, museResultSlow, TimeoutDelay, true)
+	require.Equal(t, TimeoutDelay, r)
+	require.False(t, retest)
+
+	// a working node keeps its value on one failed 测速 and is re-tested
+	l = museLatency{value: 200}
+	r, retest = l.applyKind(true, museResultSlow, TimeoutDelay, false)
+	require.Equal(t, uint16(200), r)
+	require.True(t, retest)
+
+	// preview does not keep the sample
+	l = museLatency{}
+	l.applyKind(true, museResultOK, 300, false)
+	require.Equal(t, uint16(200), l.preview(100)) // median of {300, 100}
+	require.Len(t, l.samples, 1)
+}
+
+func TestMuseRace(t *testing.T) {
+	// hedge: a second try only when the first has no answer yet
+	var tries atomic.Int32
+	s, err := museRace(context.Background(), nil, 2, 30*time.Millisecond, func(ctx context.Context, answered func()) ([]uint16, error) {
+		if tries.Add(1) == 1 {
+			<-ctx.Done() // a lost SYN
+			return nil, ctx.Err()
+		}
+		answered()
+		return []uint16{120}, nil
+	})
+	require.NoError(t, err)
+	require.Equal(t, []uint16{120}, s)
+	require.Equal(t, int32(2), tries.Load())
+
+	tries.Store(0)
+	_, err = museRace(context.Background(), nil, 2, 20*time.Millisecond, func(ctx context.Context, answered func()) ([]uint16, error) {
+		tries.Add(1)
+		answered()
+		time.Sleep(60 * time.Millisecond) // samples still running
+		return []uint16{90}, nil
+	})
+	require.NoError(t, err)
+	require.Equal(t, int32(1), tries.Load(), "answered in time: no second connection")
+
+	// refused: one try, fast failure
+	tries.Store(0)
+	_, err = museRace(context.Background(), nil, 2, 20*time.Millisecond, func(ctx context.Context, answered func()) ([]uint16, error) {
+		tries.Add(1)
+		return nil, errors.New("connection refused")
+	})
+	require.True(t, museFastFailure(err))
+	require.Equal(t, int32(1), tries.Load())
+
+	// all at once, but only within the token budget
+	tokens := make(chan struct{}, 2)
+	tries.Store(0)
+	_, err = museRace(context.Background(), tokens, 3, 0, func(ctx context.Context, answered func()) ([]uint16, error) {
+		tries.Add(1)
+		return nil, context.DeadlineExceeded
+	})
+	require.Error(t, err)
+	require.False(t, museFastFailure(err))
+	require.Equal(t, int32(2), tries.Load(), "a third connection would exceed the budget")
+	require.Len(t, tokens, 0, "tokens are given back")
+}
+
+type museTestNodes struct {
+	server  *httptest.Server
+	addr    M.Socksaddr
+	dials   sync.Map // tag -> *atomic.Int32
+	open    atomic.Int32
+	peak    atomic.Int32
+	dialer  net.Dialer
+	connect time.Duration
+}
+
+func newMuseTestNodes(t *testing.T) *museTestNodes {
+	n := &museTestNodes{connect: 30 * time.Millisecond}
+	n.server = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		require.Equal(t, http.MethodHead, r.Method)
+		w.WriteHeader(http.StatusNoContent)
+	}))
+	t.Cleanup(n.server.Close)
+	n.addr = M.ParseSocksaddr(n.server.Listener.Addr().String())
+	return n
+}
+
+func (n *museTestNodes) count(tag string) int32 {
+	v, _ := n.dials.LoadOrStore(tag, new(atomic.Int32))
+	return v.(*atomic.Int32).Load()
+}
+
+type countedConn struct {
+	net.Conn
+	once sync.Once
+	n    *museTestNodes
+}
+
+func (c *countedConn) Close() error {
+	c.once.Do(func() { c.n.open.Add(-1) })
+	return c.Conn.Close()
+}
+
+// good: answers; blackhole: never answers; refused: refused at once; flaky: first connection lost
+func (n *museTestNodes) node(tag, behaviour string) *fakeOutbound {
+	var flaky atomic.Int32
+	return &fakeOutbound{tag: tag, dial: func(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
+		if destination != n.addr {
+			return nil, errors.New("unreachable") // the exit-IP lookup
+		}
+		v, _ := n.dials.LoadOrStore(tag, new(atomic.Int32))
+		v.(*atomic.Int32).Add(1)
+		switch behaviour {
+		case "refused":
+			return nil, errors.New("dial tcp 203.0.113.1:443: connect: connection refused")
+		case "blackhole":
+			<-ctx.Done()
+			return nil, ctx.Err()
+		case "flaky":
+			if flaky.Add(1) == 1 {
+				<-ctx.Done()
+				return nil, ctx.Err()
+			}
+		}
+		select {
+		case <-time.After(n.connect):
+		case <-ctx.Done():
+			return nil, ctx.Err()
+		}
+		c, err := n.dialer.DialContext(ctx, network, n.addr.String())
+		if err != nil {
+			return nil, err
+		}
+		o := n.open.Add(1)
+		for {
+			p := n.peak.Load()
+			if o <= p || n.peak.CompareAndSwap(p, o) {
+				break
+			}
+		}
+		return &countedConn{Conn: c, n: n}, nil
+	}}
+}
+
+func museUnifiedMonitor(t *testing.T, options option.MonitoringOptions, outbounds ...adapter.Outbound) *OutboundMonitoring {
+	m := newTestMonitor(t, nil, options, outbounds...)
+	m.ctx = urltest.ContextWithIsUnifiedDelay(m.ctx)
+	require.NoError(t, m.Start(adapter.StartStateInitialize))
+	require.NoError(t, m.Start(adapter.StartStatePostStart))
+	return m
+}
+
+// End to end: refused is 超时 at once without a re-test; a node that never answers shows 0 after
+// the first tier, is re-tested with three connections and the full timeout, then 超时; a node
+// whose first connection is lost answers (hedge or re-test) and is never 超时; one connection per
+// working node.
+func TestMuseTieredTestEndToEnd(t *testing.T) {
+	n := newMuseTestNodes(t)
+	good, refused, hole, flaky := n.node("good", "good"), n.node("refused", "refused"), n.node("hole", "blackhole"), n.node("flaky", "flaky")
+	grp := &fakeGroup{fakeOutbound: fakeOutbound{tag: "grp"}, all: []string{"good", "refused", "hole", "flaky"}}
+	m := museUnifiedMonitor(t, option.MonitoringOptions{
+		URLs:           []string{n.server.URL + "/generate_204"},
+		URLTestTimeout: badoption.Duration(1500 * time.Millisecond),
+		DebounceWindow: badoption.Duration(10 * time.Millisecond),
+	}, good, refused, hole, flaky, grp)
+	// let the start-up cycle finish, then the user's 测速
+	require.Eventually(t, func() bool { return m.OutboundsHistory("grp")["hole"].Delay == TimeoutDelay }, 8*time.Second, 20*time.Millisecond)
+	for _, tag := range []string{"good", "refused", "hole", "flaky"} {
+		n.dials.Store(tag, new(atomic.Int32))
+	}
+	start := time.Now()
+	require.NoError(t, m.TestNow("grp"))
+	require.Eventually(t, func() bool { return n.count("refused") == 1 && n.count("good") == 1 }, 3*time.Second, 5*time.Millisecond)
+	require.Eventually(t, func() bool { return m.OutboundsHistory("grp")["hole"].Delay == 0 }, 3*time.Second, 5*time.Millisecond,
+		"hole: 0 (still testing) after the first tier")
+	require.Equal(t, TimeoutDelay, m.OutboundsHistory("grp")["refused"].Delay)
+	require.Eventually(t, func() bool { return m.OutboundsHistory("grp")["hole"].Delay == TimeoutDelay }, 6*time.Second, 10*time.Millisecond)
+	elapsed := time.Since(start)
+	require.Equal(t, int32(1+museRetestParallel), n.count("hole"), "first try + three connections in the re-test")
+	require.Equal(t, int32(1), n.count("refused"), "refused: no re-test")
+	require.Equal(t, int32(1), n.count("good"), "one connection per test")
+	require.Less(t, elapsed, 1500*time.Millisecond+museRetestBackoff+1500*time.Millisecond+time.Second)
+	h := m.OutboundsHistory("grp")["flaky"]
+	require.Greater(t, h.Delay, uint16(0))
+	require.Less(t, h.Delay, TimeoutDelay, "a lost first connection is not 超时")
+}
+
+// Nodes with the same configuration are tested once and share the result; a fresh result is
+// reused by automatic tests but not by 测速.
+func TestMuseSameAsAndFresh(t *testing.T) {
+	n := newMuseTestNodes(t)
+	a, b, c := n.node("a", "good"), n.node("a copy", "good"), n.node("c", "good")
+	grp := &fakeGroup{fakeOutbound: fakeOutbound{tag: "grp"}, all: []string{"a", "a copy", "c"}}
+	m := museUnifiedMonitor(t, option.MonitoringOptions{
+		URLs:           []string{n.server.URL + "/generate_204"},
+		URLTestTimeout: badoption.Duration(2 * time.Second),
+		DebounceWindow: badoption.Duration(10 * time.Millisecond),
+		MuseSameAs:     map[string]string{"a copy": "a"},
+	}, a, b, c, grp)
+	require.Eventually(t, func() bool {
+		h := m.OutboundsHistory("grp")
+		return h["a copy"].Delay > 0 && h["a copy"].Delay < TimeoutDelay && h["c"].Delay > 0 && h["c"].Delay < TimeoutDelay
+	}, 4*time.Second, 10*time.Millisecond)
+	require.Equal(t, int32(0), n.count("a copy"), "the copy is never dialed")
+	require.Equal(t, m.OutboundsHistory("grp")["a"].Delay, m.OutboundsHistory("grp")["a copy"].Delay)
+
+	// automatic test within a minute: reused
+	before := n.count("c")
+	require.NoError(t, m.testNow("c", true))
+	time.Sleep(200 * time.Millisecond)
+	require.Equal(t, before, n.count("c"), "fresh result reused")
+	// 测速: always tests
+	require.NoError(t, m.TestNow("c"))
+	require.Eventually(t, func() bool { return n.count("c") > before }, 2*time.Second, 5*time.Millisecond)
+	// the copy asked for directly is tested as "a"
+	beforeA := n.count("a")
+	require.NoError(t, m.TestNow("a copy"))
+	require.Eventually(t, func() bool { return n.count("a") > beforeA }, 2*time.Second, 5*time.Millisecond)
+	require.Equal(t, int32(0), n.count("a copy"))
+	// after a hot reload nothing is shared any more
+	require.NoError(t, m.Reload())
+	require.Equal(t, "a copy", m.primaryOf("a copy"))
+}
+
+// 60 nodes: never more test connections at once than the budget, and the gate grows past 8.
+func TestMuseManyNodesStayWithinBudget(t *testing.T) {
+	n := newMuseTestNodes(t)
+	n.connect = 40 * time.Millisecond
+	var outs []adapter.Outbound
+	var tags []string
+	for i := 0; i < 60; i++ {
+		tag := fmt.Sprintf("n%02d", i)
+		tags = append(tags, tag)
+		outs = append(outs, n.node(tag, "good"))
+	}
+	outs = append(outs, &fakeGroup{fakeOutbound: fakeOutbound{tag: "grp"}, all: tags})
+	m := museUnifiedMonitor(t, option.MonitoringOptions{
+		URLs:           []string{n.server.URL + "/generate_204"},
+		URLTestTimeout: badoption.Duration(3 * time.Second),
+	}, outs...)
+	require.Eventually(t, func() bool {
+		for _, h := range m.OutboundsHistory("grp") {
+			if h.Delay == 0 || h.Delay >= TimeoutDelay {
+				return false
+			}
+		}
+		return true
+	}, 10*time.Second, 10*time.Millisecond)
+	require.LessOrEqual(t, int(n.peak.Load()), museConnBudget(defaultWorkerCount))
+	require.Greater(t, m.gate.currentLimit(), defaultWorkerCount, "no timeouts: more tests at once")
+	require.Greater(t, int(m.gate.peakUse), defaultWorkerCount)
+}
