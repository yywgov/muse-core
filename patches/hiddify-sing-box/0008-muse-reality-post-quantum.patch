@@ -0,0 +1,91 @@
+//go:build with_utls
+
+package tls
+
+import (
+	"bytes"
+	"crypto/ecdh"
+	"net"
+	"testing"
+
+	utls "github.com/metacubex/utls"
+)
+
+func museRealityHello(t *testing.T, id utls.ClientHelloID) *utls.UConn {
+	t.Helper()
+	client, server := net.Pipe()
+	t.Cleanup(func() {
+		client.Close()
+		server.Close()
+	})
+	uConn := utls.UClient(client, &utls.Config{ServerName: "example.com", InsecureSkipVerify: true}, id)
+	if err := uConn.BuildHandshakeState(); err != nil {
+		t.Fatal(err)
+	}
+	return uConn
+}
+
+func museShares(uConn *utls.UConn) (curves []utls.CurveID, shares []utls.KeyShare) {
+	for _, extension := range uConn.Extensions {
+		switch ext := extension.(type) {
+		case *utls.SupportedCurvesExtension:
+			curves = ext.Curves
+		case *utls.KeyShareExtension:
+			shares = ext.KeyShares
+		}
+	}
+	return
+}
+
+// The REALITY hello keeps the post-quantum share and the auth key still comes
+// from the plain X25519 share the server reads.
+func TestMuseRealityHelloKeepsPostQuantumShare(t *testing.T) {
+	uConn := museRealityHello(t, utls.HelloChrome_Auto)
+	curves, shares := museShares(uConn)
+	hasCurve := false
+	for _, c := range curves {
+		if c == utls.X25519MLKEM768 {
+			hasCurve = true
+		}
+	}
+	if !hasCurve {
+		t.Fatalf("supported groups lack X25519MLKEM768: %v", curves)
+	}
+	var pq, plain []byte
+	for _, s := range shares {
+		switch s.Group {
+		case utls.X25519MLKEM768:
+			pq = s.Data
+		case utls.X25519:
+			plain = s.Data
+		}
+	}
+	if len(pq) != 1184+32 {
+		t.Fatalf("missing X25519MLKEM768 key share (len %d)", len(pq))
+	}
+	if !bytes.Contains(uConn.HandshakeState.Hello.Raw, pq) {
+		t.Fatal("X25519MLKEM768 key share not in the serialized hello")
+	}
+	key, err := realityAuthECDHEKey(uConn.HandshakeState.State13.KeyShareKeys)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if key.Curve() != ecdh.X25519() || !bytes.Equal(key.PublicKey().Bytes(), plain) {
+		t.Fatal("auth key does not match the X25519 key share")
+	}
+}
+
+func TestMuseRealityAuthKeyFromHybridOnly(t *testing.T) {
+	mlkemEcdhe, _ := ecdh.X25519().GenerateKey(bytes.NewReader(bytes.Repeat([]byte{1}, 64)))
+	p256, _ := ecdh.P256().GenerateKey(bytes.NewReader(bytes.Repeat([]byte{2}, 64)))
+	key, err := realityAuthECDHEKey(&utls.KeySharePrivateKeys{Ecdhe: p256, MlkemEcdhe: mlkemEcdhe})
+	if err != nil || key != mlkemEcdhe {
+		t.Fatalf("want hybrid X25519 key, got %v %v", key, err)
+	}
+	if _, err := realityAuthECDHEKey(nil); err == nil {
+		t.Fatal("nil keys accepted")
+	}
+	if _, err := realityAuthECDHEKey(&utls.KeySharePrivateKeys{Ecdhe: p256}); err == nil {
+		t.Fatal("P-256 only accepted")
+	}
+}
