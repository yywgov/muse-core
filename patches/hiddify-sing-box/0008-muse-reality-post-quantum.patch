+
+// realityAuthECDHEKey picks the X25519 private key the auth key is derived
+// from: the plain X25519 share when the hello carries one, otherwise the
+// X25519 half of the hybrid X25519MLKEM768 share.
+func realityAuthECDHEKey(keys *utls.KeySharePrivateKeys) (*ecdh.PrivateKey, error) {
+	if keys == nil {
+		return nil, E.New("nil KeyShareKeys")
+	}
+	if keys.Ecdhe != nil && keys.Ecdhe.Curve() == ecdh.X25519() {
+		return keys.Ecdhe, nil
+	}
+	if keys.MlkemEcdhe != nil {
+		return keys.MlkemEcdhe, nil
+	}
+	return nil, E.New("nil ecdheKey")
+}
